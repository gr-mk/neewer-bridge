#!/usr/bin/env python3
"""neewer: control a Neewer "Infinity" Bluetooth light through the local Neewer Bridge.

The bridge only moves bytes. This file holds the whole command format, so it is
the place to experiment: nothing here needs the bridge rebuilt.

Frame layout, confirmed on a CB200C (product code 20250017), and the power and
white frames again on an AS600B (product code 20240064):

    78 <tag> <size> <6 address bytes> <subtag> <values...> <checksum>

    size      counts every byte after itself, up to but not including the checksum
    checksum  low byte of the sum of every byte before it

    power   tag 8D  subtag 81  values: 01 on, 02 off
    white   tag 90  subtag 87  values: brightness 0-100, kelvin/100, tint+50, dimming curve
    colour  tag 8F  subtag 86  values: hue low byte, hue high byte, saturation 0-100, brightness 0-100, 00
    channels tag A9 subtag A8  values: brightness 0-100, red, green, blue, cold white, warm white (0-255 each), 00

On the CB200C the channels frame is the only way found to go below 1%:
brightness 1 with a single white channel at a low level is far dimmer than
"white ... 1", and it is still lit at level 1. The AS600B ignores the channels
and colour frames altogether; see PROFILES.
"""

import argparse
import colorsys
import json
import math
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request

APP_DIR = os.path.expanduser("~/Library/Application Support/NeewerBridge")
LIGHT_FILE = os.path.join(APP_DIR, "light.json")
STATE_FILE = os.path.join(APP_DIR, "state.json")

DEFAULT_BRIDGE = "http://127.0.0.1:18490"
# The widest range any light here takes. What the connected light takes is in
# its profile (below), and every frame is kept inside that.
KELVIN_MIN, KELVIN_MAX = 2500, 7500
# The curve byte is taken from captures of sibling lights; "linear" is what the
# NEEWER app sends by default. The CB200C ignores it; the AS600B honours it
# (04 makes the light's own setting linear, 01 exponential).
CURVES = {"linear": 0x04, "exp": 0x01, "log": 0x02, "s": 0x03}
CHANNELS = ("red", "green", "blue", "cold", "warm")

# What each light can do. light.json's "profile" picks one by "model" and may
# override any field; without a profile the light is taken to be a CB200C.
#   kelvin_min/max  the colour temperatures it shows. The AS600B drops a white
#                   frame outside 2700-6500K (its display keeps the old value),
#                   so nothing outside the range is ever sent.
#   curve           the dimming curve every white frame carries, or "" to let
#                   each command choose (linear unless asked).
#   channels        whether it takes the five-channel frame: `faint`,
#                   `channels` and the "sky" sunrise below 1% need it.
#   colour          whether it takes the hue/saturation frame.
#   hybrid          brightness as light output, on two curves: see HYBRID below.
#                   Empty: one curve, with output_curve.
#   output_curve    for a light with no "hybrid": [[setting %, output as a
#                   share of full], ...], how bright each setting really is.
#                   Empty: setting % = output %.
#
# Brightness, everywhere (the command, the follower, the bedtime fade, the
# morning, a fresh start, the sunrise, Apple Home), is light output as a
# percent of full, and may be a fraction. The profile turns it into the
# setting to send, and on a hybrid light the curve to send it on.
PROFILES = {
    "CB200C": {"kelvin_min": 2500, "kelvin_max": 7500, "curve": "", "channels": True, "colour": True,
               "hybrid": {}, "output_curve": []},
    # A 600 W bi-colour COB. Checked on the light, by eye on its display:
    # power and white frames as on the CB200C; the curve byte is honoured;
    # the channels frame is ignored; 2500K and 6600K are dropped.
    "AS600B": {"kelvin_min": 2700, "kelvin_max": 6500, "curve": "exp", "channels": False, "colour": False,
               "hybrid": {"threshold": 20, "hysteresis": [18, 22], "switch_pause": 1.5,
                          "exp_table": [[1, 0.0001], [45, 0.05], [55, 0.20]]},
               "output_curve": []},
}
# HYBRID: the AS600B's exponential curve goes far dimmer than its linear one,
# but is capped: exp 100 is dimmer than linear 50. So the dim end is sent on
# the exponential curve and the bright end on the linear one.
#   threshold     output % at which the light changes curve, when it is on neither
#   hysteresis    [low, high]: on linear it stays linear down to `low`; on
#                 exponential it stays there up to `high`. So a slow ramp
#                 through the threshold changes curve once, not back and forth.
#   exp_table     [[exp setting, output as a share of full], ...], matched by
#                 eye against the linear curve (taken as proportional to
#                 output): exp 45 = linear 5, exp 55 = linear 20. Exp 1 is a
#                 guess (0.01%): below 45 the output is extrapolated.
#                 Between points it follows a power of the setting. Past the
#                 last point nothing is known (only that exp 100 is dimmer than
#                 linear 50), so the output is held at the last point's, the
#                 least it can be: a raw exp 100 counts as 20%.
#   switch_pause  seconds between the two frames of a change to exponential
#
# Changing curve: the light shows the new number on its OLD curve at once and
# changes curve a moment later. Sent carelessly, linear -> exp flashes bright
# (the exp number shown on the linear curve). So a change always dips, never
# overshoots:
#   exp -> linear   the linear frame with the target number, directly: for a
#                   moment the light shows that number on exp, which is dimmer
#   linear -> exp   first an exp frame with the CURRENT number (the same light
#                   on linear, then the curve changes: a dip), a pause, then
#                   the exp target
DEFAULT_MODEL = "CB200C"


class Failure(Exception):
    """An error to show the user as one plain line."""


# ---------------------------------------------------------------- frames

def checksum(frame):
    return sum(frame) & 0xFF


def tagged(mac, tag, subtag, values):
    body = list(mac) + [subtag] + list(values)
    frame = [0x78, tag, len(body)] + body
    return frame + [checksum(frame)]


def power_frame(mac, on):
    return tagged(mac, 0x8D, 0x81, [0x01 if on else 0x02])


def white_frame(mac, kelvin, brightness, tint=0, curve="linear"):
    return tagged(mac, 0x90, 0x87, [brightness, kelvin // 100, tint + 50, CURVES[curve]])


def colour_frame(mac, hue, saturation, brightness):
    return tagged(mac, 0x8F, 0x86, [hue & 0xFF, hue >> 8, saturation, brightness, 0x00])


def channels_frame(mac, brightness, red=0, green=0, blue=0, cold=0, warm=0):
    """Drives the five LED channels directly; brightness scales all of them."""
    return tagged(mac, 0xA9, 0xA8, [brightness, red, green, blue, cold, warm, 0x00])


def to_hex(frame):
    return "".join("%02x" % byte for byte in frame)


def parse_mac(text):
    parts = text.replace("-", ":").split(":")
    if len(parts) != 6:
        raise Failure("'%s' is not a Bluetooth address like AA:BB:CC:DD:EE:FF" % text)
    try:
        mac = [int(part, 16) for part in parts]
    except ValueError:
        raise Failure("'%s' is not a Bluetooth address like AA:BB:CC:DD:EE:FF" % text)
    if any(byte > 0xFF for byte in mac):
        raise Failure("'%s' is not a Bluetooth address like AA:BB:CC:DD:EE:FF" % text)
    return mac


# ---------------------------------------------------------------- files

def read_json(path, fallback):
    try:
        with open(path) as handle:
            value = json.load(handle)
        return value if isinstance(value, dict) else dict(fallback)
    except (OSError, ValueError):
        return dict(fallback)


def write_json(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temporary = path + ".tmp"
    with open(temporary, "w") as handle:
        json.dump(value, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.replace(temporary, path)


# ---------------------------------------------------------------- bridge

class Bridge:
    def __init__(self, base):
        self.base = base.rstrip("/")
        # Never route a loopback call through a system proxy.
        self.opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))

    def call(self, method, path, body=None):
        request = urllib.request.Request(self.base + path, data=body, method=method)
        try:
            with self.opener.open(request, timeout=5) as response:
                return response.status, response.read()
        except urllib.error.HTTPError as error:
            return error.code, error.read()
        except (urllib.error.URLError, OSError) as error:
            reason = getattr(error, "reason", error)
            raise Failure("cannot reach the bridge at %s (%s). Is Neewer Bridge running?" % (self.base, reason))

    def json(self, method, path, body=None):
        status, raw = self.call(method, path, body)
        try:
            value = json.loads(raw.decode("utf-8"))
        except ValueError:
            raise Failure("the bridge sent an unreadable answer (HTTP %d)" % status)
        return status, value

    def send(self, frame):
        status, value = self.json("POST", "/write", to_hex(frame).encode("ascii"))
        if status != 200 or not value.get("ok"):
            raise Failure(value.get("error", "the bridge refused the command (HTTP %d)" % status))
        return value


# ---------------------------------------------------------------- address lookup

def addresses_known_to_macos():
    """Names and addresses of Neewer lights in the system Bluetooth list.

    macOS hides the address from apps, but the commands need it, so read it from
    the same report the Bluetooth settings pane uses.
    """
    try:
        output = subprocess.run(
            ["/usr/sbin/system_profiler", "SPBluetoothDataType", "-json"],
            capture_output=True, text=True, timeout=30, check=True,
        ).stdout
        report = json.loads(output)
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    found = []

    def walk(node):
        if isinstance(node, dict):
            for key, value in node.items():
                if isinstance(value, dict) and "device_address" in value:
                    if key.startswith("NW-") or key.upper().startswith("NEEWER"):
                        found.append((key, value["device_address"]))
                walk(value)
        elif isinstance(node, list):
            for item in node:
                walk(item)

    walk(report)
    return found


def light_address(settings, override):
    if override:
        return parse_mac(override)
    if settings.get("mac"):
        return parse_mac(settings["mac"])
    found = addresses_known_to_macos()
    if len(found) == 1:
        settings["mac"] = found[0][1]
        write_json(LIGHT_FILE, settings)
        return parse_mac(found[0][1])
    if not found:
        raise Failure("I don't know the light's Bluetooth address. Run: neewer address AA:BB:CC:DD:EE:FF")
    names = ", ".join("%s (%s)" % pair for pair in found)
    raise Failure("more than one Neewer light is known (%s). Pick one with: neewer address <address>" % names)


def light_profile(settings=None):
    """The connected light's profile: PROFILES[model] with light.json's own fields over it."""
    settings = read_json(LIGHT_FILE, {}) if settings is None else settings
    given = settings.get("profile") if isinstance(settings.get("profile"), dict) else {}
    model = given.get("model") if given.get("model") in PROFILES else DEFAULT_MODEL
    profile = dict(PROFILES[model], model=str(given.get("model") or model))
    for key, default in PROFILES[DEFAULT_MODEL].items():
        if key in given and type(given[key]) is type(default):
            if key == "curve" and given[key] not in CURVES and given[key] != "":
                continue  # not a curve: the model's own stands
            profile[key] = given[key]
    profile["output_curve"] = rising_points(profile["output_curve"])
    profile["hybrid"] = hybrid_settings(profile["hybrid"])
    low = int(round(max(1000, min(10000, profile["kelvin_min"])) / 100.0)) * 100
    high = int(round(max(1000, min(10000, profile["kelvin_max"])) / 100.0)) * 100
    profile["kelvin_min"], profile["kelvin_max"] = min(low, high), max(low, high)
    return profile


def fit_kelvin(profile, value):
    """A colour temperature as the light can show it: whole hundreds, inside its range."""
    value = int(round(float(value) / 100.0)) * 100
    return max(profile["kelvin_min"], min(profile["kelvin_max"], value))


def rising_points(given):
    """[[setting, share], ...] as sorted pairs, or [] unless brighter settings give more light all the way up."""
    points = []
    for point in given if isinstance(given, list) else ():
        try:
            setting, share = float(point[0]), float(point[1])
        except (TypeError, ValueError, IndexError):
            continue
        if 1 <= setting <= 100 and 0 < share <= 1:
            points.append((setting, share))
    points.sort()
    good = all(b[0] > a[0] and b[1] > a[1] for a, b in zip(points, points[1:]))
    return points if len(points) >= 2 and good else []


def hybrid_settings(given):
    """The "hybrid" settings, checked, or {} for a light on one curve."""
    if not isinstance(given, dict) or not given:
        return {}
    table = rising_points(given.get("exp_table"))
    if not table:
        return {}

    def number(key, default, low, high):
        value = given.get(key, default)
        ok = isinstance(value, (int, float)) and not isinstance(value, bool)
        return float(max(low, min(high, value))) if ok else float(default)
    threshold = number("threshold", 20, 1, 100)
    band = given.get("hysteresis")
    try:
        low, high = sorted(float(value) for value in band)
    except (TypeError, ValueError):
        low, high = threshold, threshold
    return {"threshold": threshold, "hysteresis": (min(low, threshold), max(high, threshold)),
            "switch_pause": number("switch_pause", 1.5, 0, 10), "exp_table": table}


def power_law(points, setting):
    """Output share at a setting, from (setting, share) points: a power of the setting between
    points, the end segments' power beyond them."""
    setting = max(0.5, float(setting))
    for s0, f0 in points:
        if setting == s0:
            return min(1.0, f0)
    for (s0, f0), (s1, f1) in zip(points, points[1:]):
        if setting <= s1 or (s1, f1) == points[-1]:
            power = (math.log(f1) - math.log(f0)) / (math.log(s1) - math.log(s0))
            return min(1.0, f0 * (setting / s0) ** power)
    return points[-1][1]


def curve_output(profile, curve, number):
    """How much light a setting gives on a curve, as a share of full."""
    hybrid = profile["hybrid"]
    if number <= 0:
        return 0.0
    if hybrid and curve == "exp":
        # Past the table's last point nothing is measured (on the AS600B, only
        # that exp 100 is dimmer than linear 50), so the output is held at the
        # last point's: the least it can be. Leaving such a setting then dims.
        table = hybrid["exp_table"]
        return power_law(table, min(number, table[-1][0]))
    if hybrid:
        return max(0, min(100, number)) / 100.0
    return setting_output(profile, number)


def pick_curve(profile, output, curve_now):
    """The curve to show an output % on, from the curve the light is on now (hysteresis)."""
    hybrid = profile["hybrid"]
    if not hybrid:
        return profile["curve"] or "linear"
    low, high = hybrid["hysteresis"]
    if curve_now == "linear":
        return "linear" if output >= low else "exp"
    if curve_now == "exp":
        return "exp" if output < high else "linear"
    return "linear" if output >= hybrid["threshold"] else "exp"


def curve_number(profile, curve, output):
    """The whole-number setting, 0-100, that gives an output % on a curve."""
    if output <= 0:
        return 0
    if profile["hybrid"] and curve == "exp":
        share = output / 100.0
        return min(range(1, 101), key=lambda n: abs(math.log(curve_output(profile, "exp", n) / share)))
    if profile["hybrid"]:
        return max(1, min(100, int(round(output))))
    return output_setting(profile, output / 100.0)


def lowest_output(profile):
    """The least light the white frame can give, as a percent of full."""
    if profile["hybrid"]:
        return 100.0 * curve_output(profile, "exp", 1)
    return 100.0 * setting_output(profile, 1)


def shown_of(state):
    """What the light was last sent: {"curve", "brightness", "kelvin"}; a value not known is None."""
    shown = state.get("shown")
    if isinstance(shown, dict):
        return {key: shown.get(key) for key in ("curve", "brightness", "kelvin")}
    if state.get("mode") == "white":
        return {"curve": state.get("curve") if state.get("curve") in CURVES else None,
                "brightness": state.get("brightness"), "kelvin": state.get("kelvin")}
    return {"curve": None, "brightness": None, "kelvin": None}


def output_of(profile, state):
    """The light output a recorded white setting gives, as a percent of full."""
    output = state.get("output")
    if isinstance(output, (int, float)) and not isinstance(output, bool):
        return float(output)
    curve = state.get("curve") if state.get("curve") in CURVES else "linear"
    return 100.0 * curve_output(profile, curve, int(state.get("brightness", 0) or 0))


def plan_white(profile, state, kelvin_value, output, tint=0):
    """How to show white at an output % from where the light is now.

    Returns (steps, look). `steps` are the frames to send, as (kelvin,
    number, tint, curve, seconds to wait after). `look` is what to record:
    mode, kelvin, brightness (the number), tint, curve, output, and shown,
    the last frame. See HYBRID for why a change to the exponential curve
    takes two frames.
    """
    kelvin_value = fit_kelvin(profile, kelvin_value)
    output = max(0.0, min(100.0, float(output)))
    shown = shown_of(state)
    curve = pick_curve(profile, output, shown["curve"]) if output > 0 else (
        shown["curve"] or profile["curve"] or "linear")
    number = curve_number(profile, curve, output)
    lit = lambda c, n: c in CURVES and isinstance(n, int) and n > 0
    keep = ((shown["curve"], shown["brightness"]) if lit(shown["curve"], shown["brightness"]) else
            (state.get("curve"), state.get("brightness")))      # not known (after the fade): the record's
    if profile["hybrid"] and output > 0 and lit(*keep) and abs(100.0 * curve_output(profile, *keep) - output) < 1e-6:
        # The light already gives this output (a change of colour only, or the
        # setting from before the fade): keep its number and curve, which
        # matters for a setting sent raw with --curve.
        curve, number = keep
    steps = []
    if profile["hybrid"] and curve == "exp" and shown["curve"] != "exp" and number > 0:
        current = shown["brightness"] if isinstance(shown["brightness"], int) and shown["brightness"] > 0 else 1
        steps.append((fit_kelvin(profile, shown["kelvin"] or kelvin_value), current, tint, "exp",
                      profile["hybrid"]["switch_pause"]))
    steps.append((kelvin_value, number, tint, curve, 0.0))
    look = {"mode": "white", "kelvin": kelvin_value, "brightness": number, "tint": tint, "curve": curve,
            "output": round(output, 4), "shown": {"curve": curve, "brightness": number, "kelvin": kelvin_value}}
    return steps, look


def percent_text(value):
    """12.5 as "12.5%", 3.0 as "3%", 0.01 as "0.01%"."""
    text = "%.1f" % value if value >= 1 else "%.3f" % value
    return text.rstrip("0").rstrip(".") + "%"


def setting_output(profile, setting):
    """How much light a brightness setting gives, as a share of full: 0.01-1.0 when no curve is measured."""
    points = profile["output_curve"]
    if not points:
        return max(1, min(100, setting)) / 100.0
    setting = max(1.0, min(100.0, float(setting)))
    if setting <= points[0][0]:
        return points[0][1] * setting / points[0][0]
    for (s0, f0), (s1, f1) in zip(points, points[1:]):
        if setting <= s1:
            along = (math.log(setting) - math.log(s0)) / (math.log(s1) - math.log(s0))
            return math.exp(math.log(f0) + (math.log(f1) - math.log(f0)) * along)
    return points[-1][1]


def output_setting(profile, share):
    """The whole-percent setting, 1-100, whose light comes nearest to a share of full output."""
    share = max(1e-6, float(share))
    if not profile["output_curve"]:
        return max(1, min(100, int(round(share * 100))))
    return min(range(1, 101), key=lambda setting: abs(math.log(setting_output(profile, setting) / share)))


def white_hue_saturation(kelvin_value):
    """Approximate colour of a white point, as hue 0-360 and saturation 0-100."""
    t = kelvin_value / 100.0
    if t <= 66:
        red = 255.0
        green = 99.4708025861 * math.log(t) - 161.1195681661
        blue = 0.0 if t <= 19 else 138.5177312231 * math.log(t - 10) - 305.0447927307
    else:
        red = 329.698727446 * (t - 60) ** -0.1332047592
        green = 288.1221695283 * (t - 60) ** -0.0755148492
        blue = 255.0
    red, green, blue = (max(0.0, min(255.0, c)) / 255.0 for c in (red, green, blue))
    hue, saturation, _ = colorsys.rgb_to_hsv(red, green, blue)
    return int(round(hue * 360)) % 360, int(round(saturation * 100))


def nearest_white(profile, hue, saturation):
    """The white the light can show that is closest to a colour, for lights with no colour LEDs.

    Closest on the colour wheel: hue as the angle, saturation as the distance
    from the middle.
    """
    def point(h, s):
        return s * math.cos(math.radians(h)), s * math.sin(math.radians(h))
    want = point(hue, saturation)
    best = None
    for value in range(profile["kelvin_min"], profile["kelvin_max"] + 1, 100):
        here = point(*white_hue_saturation(value))
        gap = math.hypot(here[0] - want[0], here[1] - want[1])
        if best is None or gap < best[0]:
            best = (gap, value)
    return best[1]


def describe_profile(profile):
    can = [name for name, flag in (("colour", profile["colour"]), ("faint/channels", profile["channels"])) if flag]
    also = ", also " + " and ".join(can) if can else ", white only"
    hybrid = profile["hybrid"]
    if hybrid:
        return "%s: %d-%dK%s; exponential curve below %s output, linear above (changing at %s going down, %s going up)" % (
            profile["model"], profile["kelvin_min"], profile["kelvin_max"], also, percent_text(hybrid["threshold"]),
            percent_text(hybrid["hysteresis"][0]), percent_text(hybrid["hysteresis"][1]))
    linear = all(abs(setting_output(profile, s) - s / 100.0) < 1e-9 for s in range(1, 101))
    return "%s: %d-%dK, %s curve%s; %s" % (
        profile["model"], profile["kelvin_min"], profile["kelvin_max"], profile["curve"] or "chosen per command", also,
        "output taken as the setting (no measured output curve)" if linear else
        "output curve measured at %d points" % len(profile["output_curve"]))


def unsupported(profile, frame, command=None):
    return Failure("this light (%s) does not take the %s frame%s" % (
        profile["model"], frame, ", so %s cannot work on it" % command if command else ""))


# ---------------------------------------------------------------- argument checks

def whole_percent(text):
    try:
        value = int(text)
    except ValueError:
        raise argparse.ArgumentTypeError(
            "'%s' is not a whole number. This light dims in 1%% steps, and 1 is the lowest lit level." % text)
    if not 0 <= value <= 100:
        raise argparse.ArgumentTypeError("must be between 0 and 100")
    return value


def whole_setting(value):
    """A brightness sent as a raw setting (on a light with one curve, a colour, or --curve): a whole number."""
    if value != int(value):
        raise Failure("%g is not a whole number: a brightness sent as a setting goes in 1%% steps, and 1 is the"
                      " lowest lit level" % value)
    return int(value)


def output_percent(text):
    """Light output 0-100, as a percent of full; fractions are allowed."""
    try:
        value = float(text)
    except ValueError:
        raise argparse.ArgumentTypeError("'%s' is not a brightness like 20 or 0.5" % text)
    if not 0 <= value <= 100:
        raise argparse.ArgumentTypeError("must be between 0 and 100")
    return value


def kelvin(text):
    try:
        value = int(text)
    except ValueError:
        raise argparse.ArgumentTypeError("'%s' is not a colour temperature like 5600" % text)
    if value < 100:  # accept 56 as shorthand for 5600
        value *= 100
    value = int(round(value / 100.0)) * 100
    if not KELVIN_MIN <= value <= KELVIN_MAX:
        raise argparse.ArgumentTypeError("must be between %d and %d" % (KELVIN_MIN, KELVIN_MAX))
    return value


def bounded(low, high, what):
    def check(text):
        try:
            value = int(text)
        except ValueError:
            raise argparse.ArgumentTypeError("'%s' is not a whole number" % text)
        if not low <= value <= high:
            raise argparse.ArgumentTypeError("%s must be between %d and %d" % (what, low, high))
        return value
    return check


def rgb_hex(text):
    digits = text.lstrip("#")
    if len(digits) == 3:
        digits = "".join(ch * 2 for ch in digits)
    try:
        if len(digits) != 6:
            raise ValueError
        return tuple(int(digits[i:i + 2], 16) for i in (0, 2, 4))
    except ValueError:
        raise argparse.ArgumentTypeError("'%s' is not a colour like ff8800" % text)


# ---------------------------------------------------------------- commands

def describe(state, profile=None):
    """A setting in words. Given a hybrid light's profile, a setting recorded without
    its output (sent before outputs were kept) is shown as output too."""
    if not state:
        return "nothing sent yet"
    power = "on" if state.get("on") else "off" if state.get("on") is False else "power unknown"
    if state.get("mode") == "white":
        output, number = state.get("output"), state.get("brightness", 0)
        if output is None and profile and profile["hybrid"]:
            output = output_of(profile, state)
        curve = state.get("curve", "linear")
        if isinstance(output, (int, float)) and (curve != "linear" or abs(output - number) > 1e-6):
            # A hybrid light: output, and the number and curve that give it.
            detail = "white %dK at %s (%s %d)" % (state.get("kelvin", 0), percent_text(output), curve, number)
        else:
            detail = "white %dK at %d%%" % (state.get("kelvin", 0), number)
            if curve != "linear":
                detail += ", %s curve" % curve
        if state.get("tint"):
            detail += ", tint %+d" % state["tint"]
    elif state.get("mode") == "colour":
        detail = "colour hue %d, saturation %d%%, at %d%%" % (
            state.get("hue", 0), state.get("saturation", 0), state.get("brightness", 0))
    elif state.get("mode") == "channels":
        lit = ["%s %d" % (name, state[name]) for name in CHANNELS if state.get(name)]
        detail = "channels (%s of 255) at %d%%" % (", ".join(lit) or "all 0", state.get("brightness", 0))
    else:
        return power
    return "%s, %s" % (power, detail)


class Light:
    def __init__(self, args):
        self.settings = read_json(LIGHT_FILE, {})
        self.profile = light_profile(self.settings)
        self.state = read_json(STATE_FILE, {})
        self.bridge = Bridge(args.bridge or self.settings.get("bridge") or DEFAULT_BRIDGE)
        self.mac_override = args.mac
        self.quiet = args.quiet
        self._mac = None

    @property
    def mac(self):
        if self._mac is None:
            self._mac = light_address(self.settings, self.mac_override)
        return self._mac

    def say(self, text):
        if not self.quiet:
            print(text)

    def remember(self, **changes):
        self.state.update(changes)
        write_json(STATE_FILE, self.state)

    def wake_if_needed(self, skip):
        """Mode commands do not wake a light in standby, so switch it on first."""
        if skip or self.state.get("on") is True:
            return
        self.bridge.send(power_frame(self.mac, True))
        self.remember(on=True)
        time.sleep(0.3)

    def power(self, on):
        self.bridge.send(power_frame(self.mac, on))
        self.remember(on=on)
        self.say("on" if on else "off")

    def white_frame(self, kelvin_value, brightness, tint=0, curve="linear"):
        """A white frame as this light takes it: inside its range, and on a one-curve light with its curve."""
        curve = curve if self.profile["hybrid"] else self.profile["curve"] or curve
        return white_frame(self.mac, fit_kelvin(self.profile, kelvin_value), brightness, tint, curve)

    def white(self, kelvin_value, brightness, tint, curve, no_power=False):
        """White with the setting number as given, on a curve: the raw way."""
        self.wake_if_needed(no_power)
        kelvin_value = fit_kelvin(self.profile, kelvin_value)
        curve = curve if self.profile["hybrid"] else self.profile["curve"] or curve
        self.bridge.send(white_frame(self.mac, kelvin_value, brightness, tint, curve))
        self.remember(mode="white", kelvin=kelvin_value, brightness=brightness, tint=tint, curve=curve,
                      output=round(100.0 * curve_output(self.profile, curve, brightness), 4),
                      shown={"curve": curve, "brightness": brightness, "kelvin": kelvin_value})
        self.say(describe(self.state))

    def show_white(self, kelvin_value, output, tint=0, no_power=False, only_if_changed=False):
        """White at a light output, as a percent of full. Returns True if anything was sent.

        On a hybrid light this picks the curve and number, and changes curve
        without a flash (see HYBRID). `only_if_changed` skips the send when
        the light would show just what it shows now.
        """
        steps, look = plan_white(self.profile, self.state, kelvin_value, output, tint)
        if (only_if_changed and self.state.get("on") is True and self.state.get("mode") == "white"
                and shown_of(self.state) == look["shown"] and self.state.get("tint", 0) == tint):
            return False
        self.wake_if_needed(no_power)
        for kelvin_now, number, tint_now, curve, wait in steps:
            self.bridge.send(white_frame(self.mac, kelvin_now, number, tint_now, curve))
            if wait:
                pause(wait)
        self.remember(**look)
        self.say(describe(self.state))
        return True

    def output(self):
        """The light output last set, as a percent of full."""
        return output_of(self.profile, self.state)

    def colour(self, hue, saturation, brightness, no_power=False):
        if not self.profile["colour"]:
            # White LEDs only: the nearest white instead.
            return self.show_white(nearest_white(self.profile, hue, saturation), brightness, 0, no_power)
        self.wake_if_needed(no_power)
        self.bridge.send(colour_frame(self.mac, hue, saturation, brightness))
        self.remember(mode="colour", hue=hue, saturation=saturation, brightness=brightness)
        self.say(describe(self.state))

    def channels(self, brightness, levels, no_power=False):
        if not self.profile["channels"]:
            raise unsupported(self.profile, "channels")
        self.wake_if_needed(no_power)
        self.bridge.send(channels_frame(self.mac, brightness, **levels))
        self.remember(mode="channels", brightness=brightness, **levels)
        self.say(describe(self.state))

    def last_brightness(self):
        return self.state.get("brightness", 10)


def cmd_on(light, args):
    light.power(True)


def cmd_off(light, args):
    light.power(False)


def cmd_white(light, args):
    profile = light.profile
    if not profile["kelvin_min"] <= args.kelvin <= profile["kelvin_max"]:
        raise Failure("this light (%s) shows %d-%dK" % (profile["model"], profile["kelvin_min"], profile["kelvin_max"]))
    tint = light.state.get("tint", 0) if args.tint is None else args.tint
    if profile["hybrid"]:
        if args.curve:
            # The raw way: the number as given, on the curve asked for, with no
            # care taken over the change of curve. For comparisons by eye.
            number = light.state.get("brightness", 10) if args.brightness is None else whole_setting(args.brightness)
            light.white(args.kelvin, number, tint, args.curve, args.no_power)
            return
        output = light.output() if args.brightness is None else args.brightness
        light.show_white(args.kelvin, output, tint, args.no_power)
        return
    brightness = light.last_brightness() if args.brightness is None else whole_setting(args.brightness)
    curve = light.state.get("curve", "linear") if args.curve is None else args.curve
    if args.curve and profile["curve"] and args.curve != profile["curve"]:
        # For a comparison by eye. The curve byte changes the light's own
        # setting, so the next ordinary send puts the profile's curve back.
        light.bridge.send(white_frame(light.mac, args.kelvin, brightness, tint, args.curve))
        light.remember(mode="white", kelvin=args.kelvin, brightness=brightness, tint=tint, curve=args.curve)
        light.say("%s (once: the next ordinary send puts the %s curve back)" % (describe(light.state), profile["curve"]))
        return
    light.white(args.kelvin, brightness, tint, curve, args.no_power)


def no_colour(light, hue, saturation):
    return Failure("this light (%s) has white LEDs only; the nearest white is %dK: neewer white %d" % (
        light.profile["model"], nearest_white(light.profile, hue, saturation),
        nearest_white(light.profile, hue, saturation)))


def cmd_colour(light, args):
    if not light.profile["colour"]:
        raise no_colour(light, args.hue % 360, args.saturation)
    brightness = light.last_brightness() if args.brightness is None else args.brightness
    light.colour(args.hue % 360, args.saturation, brightness, args.no_power)


def cmd_rgb(light, args):
    red, green, blue = args.colour
    hue, saturation, _ = colorsys.rgb_to_hsv(red / 255.0, green / 255.0, blue / 255.0)
    if not light.profile["colour"]:
        raise no_colour(light, int(round(hue * 360)) % 360, int(round(saturation * 100)))
    brightness = light.last_brightness() if args.brightness is None else args.brightness
    light.colour(int(round(hue * 360)) % 360, int(round(saturation * 100)), brightness, args.no_power)


def cmd_channels(light, args):
    if not light.profile["channels"]:
        raise unsupported(light.profile, "channels", "`neewer channels`")
    levels = {name: getattr(args, name) for name in CHANNELS}
    brightness = light.last_brightness() if args.brightness is None else args.brightness
    light.channels(brightness, levels, args.no_power)


def cmd_faint(light, args):
    """Below 1%: brightness 1 with only white channels lit, at a level of 1-255."""
    if not light.profile["channels"]:
        raise Failure("this light (%s) does not take the channels frame, so `neewer faint` cannot work on it; "
                      "neewer white <kelvin> 1 is as low as it goes" % light.profile["model"])
    levels = dict.fromkeys(CHANNELS, 0)
    for name in ("warm", "cold") if args.white == "both" else (args.white,):
        levels[name] = args.level
    light.channels(1, levels, args.no_power)


def cmd_brightness(light, args):
    state = light.state
    if state.get("mode") == "colour":
        light.colour(state.get("hue", 0), state.get("saturation", 100), whole_setting(args.brightness), args.no_power)
    elif state.get("mode") == "channels" and light.profile["channels"]:
        light.channels(whole_setting(args.brightness), {name: state.get(name, 0) for name in CHANNELS}, args.no_power)
    elif light.profile["hybrid"]:
        light.show_white(state.get("kelvin", 5600), args.brightness, state.get("tint", 0), args.no_power)
    else:
        light.white(
            state.get("kelvin", 5600), whole_setting(args.brightness), state.get("tint", 0),
            state.get("curve", "linear"), args.no_power)


# ---------------------------------------------------------------- sunrise

# Red level at which warm white starts to come in. Red alone is the dimmest
# thing the light can show, so the ramp opens with it.
SUNRISE_RED_TOP = 32
# A sunrise usually runs unattended, so a lost link is waited out rather than
# ending the ramp. It gives up only this long after the ramp should have ended.
SUNRISE_RETRY_SECONDS = 2.0
SUNRISE_GIVE_UP_SECONDS = 300.0


# Clear-sky illuminance on level ground against the sun's elevation, in lux:
# the standard natural-illumination table (Brown 1952, as carried in the
# Explanatory Supplement to the Astronomical Almanac). -6 is the start of civil
# twilight, -0.8 is sunrise as seen, 0 is the sun's centre on the horizon.
SKY_LUX = ((-18, 6.5e-4), (-12, 8.3e-3), (-6, 3.4), (-0.8, 453), (0, 759),
           (5, 4760), (10, 10900), (15, 18600), (20, 26700))
# Where the "sky" sunrise ends: by 10 degrees up the fast change is over.
SKY_TOP_ELEVATION = 10.0
# Colour against elevation, for a view towards the sunrise: blue twilight, an
# orange sun on the horizon, then whitening. Unlike the brightness this is an
# approximation, not a measured table; the last point is the --kelvin target.
SKY_KELVIN = ((-12, 7500), (-5, 7500), (-3, 6000), (-1.5, 4000), (0, 2800), (2, 3200), (5, 4000))
# The sky sunrise runs wholly in the channels frame, because switching between
# it and the white frame shows a wrong colour for a moment. Matched by eye on
# this light against the white frame at 2800K, at 1% and at 10%:
#   channels brightness b with levels adding up to 176 is as bright as white b%
#   2800K is about 95% warm and 5% cold, which puts the warm LEDs near 2700K
#   a little red (about 1 part in 60) takes off a green cast
CHANNELS_FULL = 176
WARM_KELVIN, COLD_KELVIN = 2700, 7500
SKY_RED_SHARE = 3 / 176.0


def interpolate(table, x, log=False):
    """Straight-line lookup in a sorted (x, y) table; in log y if asked."""
    if x <= table[0][0]:
        return table[0][1]
    for (x0, y0), (x1, y1) in zip(table, table[1:]):
        if x <= x1:
            t = (x - x0) / (x1 - x0)
            if log:
                return math.exp(math.log(y0) + (math.log(y1) - math.log(y0)) * t)
            return y0 + (y1 - y0) * t
    return table[-1][1]


def sky_start_elevation(top_brightness, faintest=1.0 / CHANNELS_FULL):
    """The elevation at which the real sky is as dim as the light's faintest level.

    `faintest` is that level as a percent of full output: 1/176 of 1% with the
    channels frame, and with the white frame alone the output at setting 1.
    """
    floor = interpolate(SKY_LUX, SKY_TOP_ELEVATION, log=True) * faintest / float(top_brightness)
    low, high = SKY_LUX[0][0], SKY_TOP_ELEVATION
    for _ in range(40):
        middle = (low + high) / 2
        if interpolate(SKY_LUX, middle, log=True) < floor:
            low = middle
        else:
            high = middle
    return high


def sky_white_setting(progress, top_brightness, top_kelvin, profile):
    """The "sky" sunrise for a light with no channels frame: the white frame only.

    The same sky as below, in light output: `top_brightness` is the output to
    end at, as a percent of full, and so is the third value returned. The
    ramp starts where the sky is as dim, relative to that, as the light's
    lowest setting is; the light is given each step's output (see show_white). The colour is
    the sky's, kept inside what the light shows, so blue twilight is the
    light's coolest white.
    """
    start = sky_start_elevation(top_brightness, faintest=lowest_output(profile))
    elevation = start + (SKY_TOP_ELEVATION - start) * min(1.0, max(0.0, progress))
    percent = top_brightness * interpolate(SKY_LUX, elevation, log=True) / interpolate(
        SKY_LUX, SKY_TOP_ELEVATION, log=True)
    colour = interpolate(SKY_KELVIN + ((SKY_TOP_ELEVATION, top_kelvin),), elevation)
    return ("white", fit_kelvin(profile, colour), round(max(lowest_output(profile), min(100.0, percent)), 4))


def sky_setting(progress, top_brightness, top_kelvin):
    """The "sky" sunrise: the light follows the real sky's brightness.

    The sun climbs at a steady rate, as it very nearly does around sunrise, from
    the elevation where the sky is as dim as the light's faintest level up to
    10 degrees. At each moment the light is as bright, relative to its target,
    as the sky is relative to the sky at 10 degrees. So the ratios are the real
    ones: about a third of the ramp is twilight below 1%, and brightness climbs
    fastest just before the sun comes up, as it does outside.
    """
    start = sky_start_elevation(top_brightness)
    elevation = start + (SKY_TOP_ELEVATION - start) * min(1.0, max(0.0, progress))
    percent = top_brightness * interpolate(SKY_LUX, elevation, log=True) / interpolate(
        SKY_LUX, SKY_TOP_ELEVATION, log=True)
    colour = interpolate(SKY_KELVIN + ((SKY_TOP_ELEVATION, top_kelvin),), elevation)
    colour = max(KELVIN_MIN, min(KELVIN_MAX, colour))
    # The frame's brightness is a whole percent, so take the next one up and
    # trim with the levels: steps stay fine all the way to the top.
    brightness = max(1, min(100, int(math.ceil(percent - 1e-9))))
    level = max(1, min(CHANNELS_FULL, int(round(CHANNELS_FULL * percent / brightness))))
    share = (1e6 / WARM_KELVIN - 1e6 / colour) / (1e6 / WARM_KELVIN - 1e6 / COLD_KELVIN)
    cold = int(round(level * max(0.0, min(1.0, share))))
    red = int(round(level * SKY_RED_SHARE))
    levels = {name: value for name, value in (("red", red), ("cold", cold), ("warm", level - cold)) if value}
    return ("channels", brightness, levels)


def sunrise_setting(progress, top_brightness, top_kelvin, style="sky", profile=None):
    """The light setting at a point in the sunrise, from 0.0 (start) to 1.0 (end).

    Returns ("channels", brightness, levels) or ("white", kelvin, brightness).
    On a light that takes the channels frame, the sky style only ever returns
    the first kind; on one that does not, every style returns only the second.
    """
    profile = PROFILES[DEFAULT_MODEL] if profile is None else profile
    if not profile["channels"]:
        if style == "sky":
            return sky_white_setting(progress, top_brightness, top_kelvin, profile)
        return glow_white_setting(progress, top_brightness, top_kelvin, profile)
    if style == "sky":
        return sky_setting(progress, top_brightness, top_kelvin)
    return glow_setting(progress, top_brightness, top_kelvin)


def glow_white_setting(progress, top_brightness, top_kelvin, profile):
    """The "glow" sunrise for a light with no channels frame: its last stage only,
    over the whole time. Light output from the lowest setting's up to the target
    by a constant ratio, warmest white to the target colour."""
    x = min(1.0, max(0.0, progress))
    low = lowest_output(profile)
    brightness = round(low * (top_brightness / low) ** x, 4)
    return ("white", fit_kelvin(profile, profile["kelvin_min"] + (top_kelvin - profile["kelvin_min"]) * x), brightness)


def glow_setting(progress, top_brightness, top_kelvin):
    """The "glow" sunrise: a designed ramp, not the real sky.

    Three stages: a red glow that grows, warm white that takes over from the
    red (both below 1%, through the channels frame), then ordinary white that
    brightens and cools. The eye judges brightness by ratio, so each stage
    climbs by a constant ratio per unit of time, and each stage gets a share of
    the time in proportion to how many doublings it covers.
    """
    doublings = (math.log2(SUNRISE_RED_TOP), math.log2(255), math.log2(max(2, top_brightness)))
    red_ends = doublings[0] / sum(doublings)
    warm_ends = (doublings[0] + doublings[1]) / sum(doublings)
    if progress < red_ends:
        x = progress / red_ends
        return ("channels", 1, {"red": max(1, int(round(SUNRISE_RED_TOP ** x)))})
    if progress < warm_ends:
        x = (progress - red_ends) / (warm_ends - red_ends)
        return ("channels", 1, {
            "red": int(round(SUNRISE_RED_TOP * (1 - x))),
            "warm": max(1, int(round(255 ** x))),
        })
    x = min(1.0, (progress - warm_ends) / (1 - warm_ends))
    brightness = max(1, int(round(top_brightness ** x)))
    kelvin_now = KELVIN_MIN + (top_kelvin - KELVIN_MIN) * x
    return ("white", int(round(kelvin_now / 100.0)) * 100, brightness)


def describe_setting(setting):
    if setting[0] == "channels":
        lit = ", ".join("%s %d" % (name, level) for name, level in sorted(setting[2].items()) if level)
        if setting[1] > 1:
            return "channels at %d%%: %s" % (setting[1], lit)
        return "faint: %s" % lit
    return "white %dK at %s" % (setting[1], percent_text(setting[2]))


def cmd_sunrise(light, args):
    total = args.minutes * 60.0
    args.kelvin = fit_kelvin(light.profile, args.kelvin)
    if args.plan:
        # Played through as the light would get it, so the steps shown are
        # the frames that would be sent, and where the curve would change.
        last, state = None, dict(light.state)
        for tick in range(4001):
            setting = sunrise_setting(tick / 4000.0, args.brightness, args.kelvin, args.style, light.profile)
            text = describe_setting(setting)
            if setting[0] == "white":
                steps, look = plan_white(light.profile, state, setting[1], setting[2])
                if look["shown"] == shown_of(state) and last is not None:
                    continue
                if light.profile["hybrid"]:
                    text += " (%s %d)" % (look["curve"], look["brightness"])
                if len(steps) > 1:
                    text += ", changing to exponential: exp %d first, then %gs" % (steps[0][1], steps[0][4])
                state.update(look)
            elif setting == last:
                continue
            at = total * tick / 4000.0
            print("%3d:%02d  %s" % (at // 60, at % 60, text))
            last = setting
        return

    def stamp():
        try:
            return os.stat(STATE_FILE).st_mtime_ns
        except OSError:
            return None

    def note(text):
        if not quiet:
            print(text, flush=True)

    own_stamp = None

    def send(setting):
        nonlocal own_stamp
        if setting[0] == "channels":
            levels = dict.fromkeys(CHANNELS, 0)
            levels.update(setting[2])
            light.channels(setting[1], levels, no_power=True)
        else:
            # Sent only when the light would show something new.
            light.show_white(setting[1], setting[2], 0, no_power=True, only_if_changed=awake)
        own_stamp = stamp()

    def switch_on(setting):
        """Always sends power on: the state file only says what was last sent,
        and the light may have been put in standby on its own button, or lost
        power. The step goes out before the power frame as well as after it, so
        a light that keeps settings while in standby wakes faint, not at its
        old setting."""
        nonlocal own_stamp
        send(setting)
        light.power(True)
        own_stamp = stamp()
        time.sleep(0.3)  # a light coming out of standby ignores what follows too closely

    quiet, light.quiet = light.quiet, True  # one line per stage, not per step
    interval = max(0.1, min(1.0, total / 900.0))
    started = time.monotonic()
    last = stage = lost_since = None
    awake = False
    try:
        while True:
            progress = min(1.0, (time.monotonic() - started) / total)
            setting = sunrise_setting(progress, args.brightness, args.kelvin, args.style, light.profile)
            if setting != last or not awake:
                # Anything else that sets the light (Home, another neewer
                # command) rewrites the state file; treat that as "stop".
                if own_stamp is not None and stamp() != own_stamp:
                    note("sunrise stopped: the light was changed elsewhere")
                    return
                try:
                    if not awake:
                        switch_on(setting)
                        awake = True
                    send(setting)
                except Failure as failure:
                    # After an outage the light may have lost power, so it is
                    # switched on again once it is back.
                    awake = False
                    if lost_since is None:
                        lost_since = time.monotonic()
                        note("lost the light (%s); retrying" % failure)
                    if progress >= 1.0 and time.monotonic() - started > total + SUNRISE_GIVE_UP_SECONDS:
                        raise Failure("sunrise gave up: %s" % failure)
                    time.sleep(SUNRISE_RETRY_SECONDS)
                    continue
                if lost_since is not None:
                    note("the light is back after %s" % duration(time.monotonic() - lost_since))
                    lost_since = None
                last = setting
                if args.style == "sky":
                    faint = setting[1] == 1 if setting[0] == "channels" else setting[2] < 1
                    name = "twilight" if faint else "daylight coming up"
                elif setting[0] == "channels":
                    name = "warm white coming in" if setting[2].get("warm") else "red glow"
                else:
                    name = "white, brightening"
                if name != stage:
                    note("%s (%s)" % (name, describe_setting(setting)))
                stage = name
            if progress >= 1.0:
                break
            time.sleep(interval)
    except KeyboardInterrupt:
        note("sunrise stopped at %s" % describe(light.state))
        return
    note("sunrise finished: %s" % describe(light.state))


# ---------------------------------------------------------------- follow the sun

# `neewer follow apply` runs once a minute and sets the light from the sun.
# It does not work the sun out itself. sundial, the program that does the same
# job for the monitors, writes the sun's height and its own target to a file
# every minute, and this reads that file.
FOLLOW_FILE = os.path.join(APP_DIR, "follow.json")
FOLLOW_MEMORY_FILE = os.path.join(APP_DIR, "follow-state.json")
SUNDIAL_STATE_FILE = os.path.expanduser("~/.local/state/sundial/state.json")
SUNDIAL_STALE_SECONDS = 300
FOLLOW_DEFAULTS = {
    "enabled": True,
    "day_brightness": 100,   # brightness with the sun well up
    "night_brightness": 5,   # brightness after dark; never below 1, so never off
    "night_kelvin": 2700,    # colour after dark
    "hold_minutes": 120,     # how long a setting made elsewhere is left alone
    "fresh_start": True,     # a light switched on after being off goes straight to the sun's setting
    "bedtime_rule": True,    # fade out and switch off at bedtime
    "morning_on": True,      # and switch on again before waking, if the rule switched it off
    "fade_minutes": 5,       # how long the fade at bedtime takes
    "morning_lead_minutes": 30,  # how long before the wake time it comes back on
    "bedtime": "",           # "23:00"; empty means sundial's
    "wake": "",              # "07:00"; empty means sundial's
}
SUNDIAL_CONFIG_FILE = os.path.expanduser("~/.config/sundial/config.ini")
# Bedtime is acted on only this soon after it. Later than that (the Mac was
# asleep, or the rule was only just installed) the night is left alone.
BEDTIME_GRACE_SECONDS = 15 * 60
FADE_STEP_SECONDS = 2.0
pause = time.sleep  # the fade waits with this; the tests replace it
# The colour moves from sundial's colour to the night colour while the sun goes
# from the horizon down to the end of civil twilight.
NIGHT_COLOUR_FROM, NIGHT_COLOUR_BY = 0.0, -6.0


def follow_settings():
    """follow.json over the defaults; a value of the wrong kind is ignored."""
    given = read_json(FOLLOW_FILE, {})
    settings = dict(FOLLOW_DEFAULTS)
    for key, default in FOLLOW_DEFAULTS.items():
        value = given.get(key, default)
        if isinstance(default, bool):
            good = isinstance(value, bool)
        elif isinstance(default, str):
            good = isinstance(value, str)
        else:
            good = isinstance(value, (int, float)) and not isinstance(value, bool)
        if good:
            settings[key] = value
    settings["fade_minutes"] = max(0, settings["fade_minutes"])
    settings["morning_lead_minutes"] = max(0, settings["morning_lead_minutes"])
    settings["night_brightness"] = int(max(1, min(100, settings["night_brightness"])))
    settings["day_brightness"] = int(max(settings["night_brightness"], min(100, settings["day_brightness"])))
    settings["night_kelvin"] = fit_kelvin(light_profile(), settings["night_kelvin"])
    settings["hold_minutes"] = max(0, settings["hold_minutes"])
    return settings


def follow_output(sun, settings):
    """The light output the sun calls for, as a percent of full."""
    daylight = max(0.0, min(1.0, float(sun["daylight"])))
    low, high = settings["night_brightness"], settings["day_brightness"]
    return low + (high - low) * daylight


def follow_target(sun, settings):
    """(kelvin, light output %) for the light, from sundial's target.

    The light output runs from the night level to the day level with
    sundial's "daylight" share, as a percent of full; the light is given the
    setting that gives it (see show_white). Colour is sundial's, moving to
    the night colour as the sun goes below the horizon, and kept inside what
    the light can show.
    """
    profile = light_profile()
    # A one-curve light takes whole percents only; a hybrid one finer steps.
    brightness = round(follow_output(sun, settings), 2) if profile["hybrid"] else int(round(follow_output(sun, settings)))
    night = (NIGHT_COLOUR_FROM - float(sun["sun_elevation"])) / (NIGHT_COLOUR_FROM - NIGHT_COLOUR_BY)
    night = max(0.0, min(1.0, night))
    colour = float(sun["kelvin"]) + (settings["night_kelvin"] - float(sun["kelvin"])) * night
    return fit_kelvin(profile, colour), max(lowest_output(profile), min(100.0, brightness))


def sundial_target(now):
    """What sundial last worked out, or a Failure if it is missing or old."""
    try:
        age = now - os.stat(SUNDIAL_STATE_FILE).st_mtime
    except OSError:
        raise Failure("sundial has written no state file (%s)" % SUNDIAL_STATE_FILE)
    if age > SUNDIAL_STALE_SECONDS:
        raise Failure("sundial last ran %s ago" % duration(age))
    sun = read_json(SUNDIAL_STATE_FILE, {}).get("target")
    try:
        float(sun["daylight"]), float(sun["sun_elevation"]), float(sun["kelvin"])
    except (KeyError, TypeError, ValueError):
        raise Failure("sundial's state file has no usable target")
    return sun


def sunrise_is_running():
    """True while a `neewer sunrise` ramp is running, from a terminal or from Home."""
    try:
        listing = subprocess.run(
            ["/bin/ps", "-axo", "pid=,command="], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    for line in listing.splitlines():
        pid, _, command = line.strip().partition(" ")
        words = command.split()
        if pid == str(os.getpid()) or "--plan" in words:
            continue
        for index, word in enumerate(words):
            if os.path.basename(word) in ("neewer", "neewer_cli.py") and "sunrise" in words[index + 1:]:
                return True
    return False


def state_stamp():
    try:
        return os.stat(STATE_FILE).st_mtime_ns
    except OSError:
        return None


# ---------------------------------------------------------------- sun tracking
#
# One switch for everything that follows the sun: this light, the other one,
# the monitors and the keyboard. tracking.json is the one record of it, read
# by every follower and every Apple Home service:
#   on      true: everything follows the sun
#   since   when it last changed
#   by      who changed it: home, cli, dawn, or the device that was set by hand
#   why     a few words for the status lines
# Setting any device by hand (a colour, a brightness; not switching it on or
# off) turns tracking off, and then every device stays as it is, with no
# timer, until tracking is turned on again. It turns itself on before sunrise.
#
# settings.json beside it: "switch": false goes back to the old way, where a
# setting made by hand is held for hold_minutes and then followed again;
# "on_before_sunrise": false stops the switch turning itself on.

TRACKING_DIR = os.path.expanduser("~/Library/Application Support/SunTracking")
# A Home scene may turn the switch on and set colours in the same breath, in
# either order. The colours win: for this long after a device was set by hand,
# Home's "on" is not taken.
SCENE_SECONDS = 5


def tracking_settings():
    given = read_json(os.path.join(TRACKING_DIR, "settings.json"), {})
    return {"switch": given.get("switch") is not False,
            "on_before_sunrise": given.get("on_before_sunrise") is not False}


def tracking():
    state = read_json(os.path.join(TRACKING_DIR, "tracking.json"), {})
    return {"on": state.get("on") is not False, "since": float(state.get("since") or 0),
            "by": str(state.get("by") or ""), "why": str(state.get("why") or "")}


def set_tracking(on, by, why="", now=None):
    """Turns sun tracking on or off for everything. Returns how it stands afterwards."""
    now = time.time() if now is None else now
    state = tracking()
    if state["on"] == bool(on):
        return state
    if on and by == "home" and state["by"] not in ("home", "cli", "") and now - state["since"] < SCENE_SECONDS:
        return state  # a scene's colours came first; they win
    state = {"on": bool(on), "since": now, "by": by, "why": why}
    write_json(os.path.join(TRACKING_DIR, "tracking.json"), state)
    return state


def tracking_text(state=None):
    """Sun tracking in a few words, for the status lines."""
    state = tracking() if state is None else state
    at = time.strftime("%H:%M", time.localtime(state["since"])) if state["since"] else "the start"
    if not tracking_settings()["switch"]:
        return "not in use (a setting made by hand is held for a time instead)"
    if state["on"]:
        how = {"dawn": ", switched on before sunrise", "home": ", from Apple Home", "cli": ", by command"}
        return "on since %s%s" % (at, how.get(state["by"], ""))
    if state["by"] in ("home", "cli"):
        return "off since %s, switched off %s" % (at, "from Apple Home" if state["by"] == "home" else "by command")
    return "off since %s, when the %s %s set by hand%s" % (
        at, state["by"], "were" if state["by"] == "monitors" else "was", " (%s)" % state["why"] if state["why"] else "")


def sun_elevation(moment, latitude, longitude):
    """The sun's height in degrees at a Unix time (sundial's own formula)."""
    n = moment / 86400.0 + 2440587.5 - 2451545.0
    g = math.radians((357.528 + 0.9856003 * n) % 360)
    lam = math.radians((280.460 + 0.9856474 * n) % 360 + 1.915 * math.sin(g) + 0.020 * math.sin(2 * g))
    eps = math.radians(23.439 - 0.0000004 * n)
    ra = math.atan2(math.cos(eps) * math.sin(lam), math.cos(lam))
    dec = math.asin(math.sin(eps) * math.sin(lam))
    ha = math.radians(((18.697374558 + 24.06570982441908 * n) % 24) * 15 + longitude) - ra
    la = math.radians(latitude)
    return math.degrees(math.asin(math.sin(la) * math.sin(dec) + math.cos(la) * math.cos(dec) * math.cos(ha)))


def civil_dawn(now):
    """When the sun reaches 6 degrees below the horizon this morning, or None.

    The place is sundial's ([location] in its settings). Civil dawn is always
    before sunrise, by about half an hour.
    """
    import configparser
    sundial = configparser.ConfigParser(inline_comment_prefixes=("#", ";"))
    try:
        sundial.read(SUNDIAL_CONFIG_FILE)
        latitude, longitude = sundial.getfloat("location", "latitude"), sundial.getfloat("location", "longitude")
    except (configparser.Error, ValueError):
        return None
    today = time.localtime(now)
    midnight = time.mktime((today.tm_year, today.tm_mon, today.tm_mday, 0, 0, 0, 0, 0, -1))
    if sun_elevation(midnight, latitude, longitude) >= -6:
        return None  # no night to speak of
    for minute in range(1, 14 * 60):
        if sun_elevation(midnight + minute * 60, latitude, longitude) >= -6:
            return midnight + minute * 60
    return None


def tracking_tick(settings, now):
    """Turns tracking on before sunrise, once a day: at civil dawn or the morning time, whichever is first.

    Only if it was switched off before then. Switched off later in the day,
    it stays off until the next morning.
    """
    chosen, state = tracking_settings(), tracking()
    if not chosen["switch"] or not chosen["on_before_sunrise"] or state["on"]:
        return
    due = [civil_dawn(now)]
    times = sleep_times(settings)
    if times is not None:
        today = time.localtime(now)
        due.append(time.mktime((today.tm_year, today.tm_mon, today.tm_mday, times[1] // 60, times[1] % 60, 0, 0, 0, -1))
                   - settings["morning_lead_minutes"] * 60)
    due = [moment for moment in due if moment is not None]
    if due and state["since"] < min(due) <= now:
        set_tracking(True, "dawn", now=now)


def cmd_tracking(thing, args):
    """`tracking`, `tracking on`, `tracking off`: the one switch for everything that follows the sun."""
    if args.action in ("on", "off"):
        set_tracking(args.action == "on", "cli")
        if args.action == "on":
            line = follow_apply(thing)  # this one at once; the others notice within seconds
            if line:
                print(line)
    print("Sun tracking: %s" % tracking_text())


# ---------------------------------------------------------------- bedtime
#
# The one place the follower switches the light off and on. At bedtime it
# fades the light out and switches it off, once. Before the wake time it
# switches it on again, if it was the one that switched it off. Anything done
# by hand in between is left alone until morning.
#
# memory["night"] is what it knows about the present night:
#   start   when this night's bedtime was
#   state   "off": the follower switched the light off
#           "skip": the night is left alone; "why" says why
#           "done": the morning has been dealt with

def clock_minutes(text):
    """"23:00" as minutes after midnight, or None."""
    try:
        hours, minutes = str(text).strip().split(":")
        hours, minutes = int(hours), int(minutes)
    except ValueError:
        return None
    return hours * 60 + minutes if 0 <= hours < 24 and 0 <= minutes < 60 else None


def sleep_times(settings):
    """(bedtime, wake) in minutes after midnight, or None if either is unknown.

    follow.json's own "bedtime" and "wake" win. Otherwise they are sundial's,
    read from its settings file each time, so there is one place to change them.
    """
    import configparser
    sundial = configparser.ConfigParser(inline_comment_prefixes=("#", ";"))
    try:
        sundial.read(SUNDIAL_CONFIG_FILE)
    except configparser.Error:
        pass
    times = []
    for key in ("bedtime", "wake"):
        minutes = clock_minutes(settings[key])
        if minutes is None:
            minutes = clock_minutes(sundial.get("sleep", key, fallback=""))
        times.append(minutes)
    return None if None in times else tuple(times)


def night_window(now, bedtime, wake, lead_minutes):
    """(start, morning): the latest bedtime that has passed, and when that night ends.

    The night ends `lead_minutes` before the first wake time after it. From
    then until the next bedtime it is day.
    """
    today = time.localtime(now)

    def at(day, minutes):
        return time.mktime((today.tm_year, today.tm_mon, today.tm_mday + day, minutes // 60, minutes % 60, 0, 0, 0, -1))
    start = max(moment for moment in (at(-1, bedtime), at(0, bedtime)) if moment <= now)
    woke = min(moment for moment in (at(-1, wake), at(0, wake), at(1, wake)) if moment > start)
    return start, max(start, woke - lead_minutes * 60)


def hhmm(moment):
    return time.strftime("%H:%M", time.localtime(moment))


def night_sentence(night, on, morning, settings):
    if night["state"] == "off":
        return "off for the night; on at %s" % hhmm(morning) if settings["morning_on"] else "off for the night"
    if not on:
        return "off by hand; left alone tonight"
    if night.get("why") == "sunrise":
        return "a sunrise was running at bedtime; left alone tonight"
    if night.get("since"):
        return "on by hand since %s; left alone tonight" % hhmm(night["since"])
    return "on by hand; left alone tonight"


def bedtime_step(light, memory, settings, now, send, sunrise_running):
    """The bedtime rule's part of one run. None means: carry on following.

    Otherwise (situation, sentence, sent), as follow_step returns.
    """
    times = sleep_times(settings) if settings["bedtime_rule"] else None
    if times is None:
        memory.pop("night", None)
        return None
    start, morning = night_window(now, times[0], times[1], settings["morning_lead_minutes"])
    night = memory.get("night")
    if not isinstance(night, dict) or night.get("start") != start:
        night = None
    on = light.state.get("on") is True

    if now >= morning:
        # Day. Switch on once, if the follower was the one that switched off.
        if night is None or night["state"] != "off":
            return None
        if on or not settings["morning_on"] or sunrise_running():
            if send:
                memory["night"] = dict(night, state="done")
            return None
        if not send:
            return "morning", "about to switch on for the morning", False
        kelvin_now, output = follow_target(sundial_target(now), settings)
        light.show_white(kelvin_now, output, 0)  # switches on first
        memory.pop("manual", None)
        memory["stamp"], memory["sent"] = state_stamp(), follow_look(light.state)
        memory["night"] = dict(night, state="done")
        memory["fresh"] = False
        return "following", "morning: switched on at white %dK at %s" % (kelvin_now, percent_text(output)), True

    if night is None:
        # Bedtime has come. It is acted on once, and only close to the time.
        if now - start > BEDTIME_GRACE_SECONDS:
            night = {"start": start, "state": "skip", "why": "late"}
        elif not on:
            night = {"start": start, "state": "skip", "why": "off"}
        elif sunrise_running():
            night = {"start": start, "state": "skip", "why": "sunrise"}
        elif not send:
            return "bedtime", "about to fade out and switch off for the night", False
        else:
            finished, ended = fade_out(light, memory, settings["fade_minutes"] * 60.0, now)
            if finished:
                memory["night"] = night = {"start": start, "state": "off", "at": ended}
                memory["fresh"] = True  # off now: the next switching on by day starts afresh
                sentence = night_sentence(night, False, morning, settings)
                return night_situation(sentence), "bedtime: faded out and switched off; " + sentence, True
            # Set by someone during the fade: theirs now.
            night = {"start": start, "state": "skip", "why": "hand", "since": ended}
            light.state = read_json(STATE_FILE, {})
            on = light.state.get("on") is True
        if send:
            memory["night"] = night
    if night["state"] == "off" and on:
        # Switched back on by hand. Left alone; it is not switched off twice.
        night = {"start": start, "state": "skip", "why": "hand", "since": now}
        if send:
            memory["night"] = night
    if night["state"] == "skip" and night.get("why") == "off" and on:
        night = dict(night, why="hand", since=now)
        if send:
            memory["night"] = night
    sentence = night_sentence(night, on, morning, settings)
    return night_situation(sentence), sentence, False


def in_night(settings, now):
    """True between bedtime and the morning, when the bedtime rule is in force."""
    times = sleep_times(settings) if settings["bedtime_rule"] else None
    if times is None:
        return False
    return now < night_window(now, times[0], times[1], settings["morning_lead_minutes"])[1]


# A fresh start: a light that was off and is switched on again by day goes
# straight to the sun's setting and is followed. Without this it comes back as
# it was left (last night's warm white, say), and any touch of the brightness
# then holds that for two hours.
#
# memory["fresh"] says one is due. It is set whenever the follower sees the
# light off, and when a new day begins.

def fresh_bookkeeping(memory, settings, on, now):
    if not on:
        memory["fresh"] = True
    times = sleep_times(settings) if settings["bedtime_rule"] else None
    if times is not None:
        morning = night_window(now, times[0], times[1], settings["morning_lead_minutes"])[1]
        if now >= morning and memory.get("day") != morning:
            memory["day"], memory["fresh"] = morning, True


def starting_now(memory, settings, on, now):
    """Following is switched on: that is not a new day, nor a fresh start.

    A follower that was off through the morning has not seen the day begin.
    Left to itself it would take that, or the light having been on all along,
    for a fresh start, and set the sun's level at once: full brightness at
    midday, with sun tracking off and nobody asking.
    """
    times = sleep_times(settings) if settings["bedtime_rule"] else None
    if times is not None:
        morning = night_window(now, times[0], times[1], settings["morning_lead_minutes"])[1]
        if now >= morning:
            memory["day"] = morning
    if on:
        memory["fresh"] = False


def fresh_start_look(now=None):
    """(kelvin, brightness) a light switched on right now should get, or None.

    None when fresh starts or following are switched off, at night, or when
    sundial cannot be read. The Apple Home service asks this as Home switches
    the light on, so there is no minute of the old setting first.
    """
    now = time.time() if now is None else now
    settings = follow_settings()
    if not settings["enabled"] or not settings["fresh_start"] or in_night(settings, now):
        return None
    try:
        return follow_target(sundial_target(now), settings)
    except Failure:
        return None


def fresh_start_done(now=None):
    """Records that the light as it is now is the follower's own, freshly set."""
    memory = read_json(FOLLOW_MEMORY_FILE, {})
    memory.pop("manual", None)
    memory.update(stamp=state_stamp(), sent=follow_look(read_json(STATE_FILE, {})), fresh=False,
                  fresh_at=time.time() if now is None else now)
    write_json(FOLLOW_MEMORY_FILE, memory)


def night_situation(sentence):
    # One log line for each thing the night turns into, not one a minute.
    return "night: " + sentence.split(";")[0]


def fade_out(light, memory, seconds, now):
    """Fades the light down to its lowest and switches it off. (finished, when).

    It stops, leaving the light as it is, if anything else sets the light
    meanwhile. The record keeps the setting from before the fade, so switching
    the light on by hand brings that back and not the fade's last step.
    """
    before = dict(light.state)
    mine = state_stamp() == memory.get("stamp") or follow_look(before) == memory.get("sent")
    colour = before.get("mode") == "colour" and light.profile["colour"]
    top = int(before.get("brightness", 1)) if colour else output_of(light.profile, before)
    low = 1 if colour else lowest_output(light.profile)
    stamp, elapsed, shown = state_stamp(), 0.0, top
    # The channels mode is already below 1%; there is nothing to fade through.
    while before.get("mode") in ("white", "colour") and top > low * 1.0001 and elapsed < seconds:
        pause(FADE_STEP_SECONDS)
        elapsed += FADE_STEP_SECONDS
        if state_stamp() != stamp:
            return False, now + elapsed
        # Each step is the same share dimmer than the last, in light output,
        # which looks even. On a hybrid light it changes to the exponential
        # curve on the way down, with a dip (see HYBRID).
        level = top * (float(low) / top) ** min(1.0, elapsed / seconds)
        if colour:
            level = max(1, int(round(level)))
            if level != shown:
                light.colour(before.get("hue", 0), before.get("saturation", 100), level, no_power=True)
                shown, stamp = level, state_stamp()
        elif light.show_white(before.get("kelvin", 5600), level, before.get("tint", 0),
                              no_power=True, only_if_changed=True):
            shown, stamp = level, state_stamp()
    if state_stamp() != stamp:
        return False, now + elapsed
    light.bridge.send(power_frame(light.mac, False))
    if shown != top:
        # In case the light keeps a setting sent in standby: leave it the old
        # one, so its own button wakes it as it was. Not known to work.
        try:
            pause(0.3)
            if colour:
                frame = colour_frame(light.mac, before.get("hue", 0), before.get("saturation", 100), top)
            elif before["mode"] == "colour":
                frame = light.white_frame(nearest_white(light.profile, before.get("hue", 0), before.get("saturation", 100)),
                                          int(before.get("brightness", 1)))
            else:
                frame = light.white_frame(before.get("kelvin", 5600), int(before.get("brightness", 1)),
                                          before.get("tint", 0), before.get("curve", "linear"))
            light.bridge.send(frame)
        except Failure:
            pass
        # Whether a light in standby keeps a frame is not known, so which
        # curve it is on now is not known either.
        light.state["shown"] = {"curve": None, "brightness": None, "kelvin": None}
    shown_now = light.state.get("shown") or shown_of(light.state)
    light.state = dict(before, on=False, shown=shown_now)
    write_json(STATE_FILE, light.state)
    if mine:
        memory["stamp"], memory["sent"] = state_stamp(), follow_look(light.state)
    return True, now + elapsed


def bedtime_outlook(light, settings, memory, now):
    """What the bedtime rule will do next, for `neewer follow`."""
    if not settings["bedtime_rule"]:
        return "the rule is switched off"
    times = sleep_times(settings)
    if times is None:
        return "no bedtime known; set bedtime and wake in follow.json, or [sleep] in sundial's settings"
    start, morning = night_window(now, times[0], times[1], settings["morning_lead_minutes"])
    night = memory.get("night")
    if not isinstance(night, dict) or night.get("start") != start:
        night = None
    if now < morning and night is not None and night["state"] in ("off", "skip"):
        return night_sentence(night, light.state.get("on") is True, morning, settings)
    if now < morning and night is None:
        return "bedtime was %s; fading out now" % hhmm(start) if now - start <= BEDTIME_GRACE_SECONDS \
            else "on by hand; left alone tonight"
    if night is not None and night["state"] == "off" and settings["morning_on"]:
        return "switching on for the morning"
    following = night_window(now + 86400, times[0], times[1], settings["morning_lead_minutes"])
    text = "off at %02d:%02d" % (times[0] // 60, times[0] % 60)
    if settings["morning_on"]:
        text += ", on again at %s" % hhmm(following[1])
    return text


def follow_look(state):
    """The part of the last setting that says how the light looks.

    Power is left out, so switching the light off and on is not taken for a
    new setting. For white, only what the white frame carries counts: Apple
    Home rewrites the other keys when it switches the light.
    """
    if state.get("mode") == "white":
        look = {key: state.get(key, 0) for key in ("mode", "kelvin", "brightness", "tint")}
        look["curve"] = state.get("curve") if state.get("curve") in CURVES else "linear"
        return look
    return {key: value for key, value in state.items() if key not in ("on", "output", "shown")}


def follow_step(light, memory, now, send=True, sunrise_running=sunrise_is_running):
    """Decides what to do this minute and, if `send`, does it.

    Returns (situation, sentence, sent). `memory` is what the follower keeps
    between runs, and is updated in place:
      stamp, sent   the state file as the follower last left it
      manual        a setting made elsewhere, and when it was made
    """
    settings = follow_settings()
    if not settings["enabled"]:
        return "off", "following is switched off", False
    if send:
        tracking_tick(settings, now)
        fresh_bookkeeping(memory, settings, light.state.get("on") is True, now)
    verdict = bedtime_step(light, memory, settings, now, send, sunrise_running)
    if verdict is not None:
        return verdict
    state = light.state
    stamp = state_stamp()
    look = follow_look(state)

    # Whose setting is this? The follower's own, if the state file is as it
    # left it, or shows the same setting (only the power was switched).
    until, manual = None, None
    if stamp == memory.get("stamp") or look == memory.get("sent"):
        memory.pop("manual", None)
        memory["stamp"] = stamp
    else:
        manual = memory.get("manual")
        if not isinstance(manual, dict) or manual.get("look") != look:
            manual = memory["manual"] = {"look": look, "since": (stamp or 0) / 1e9}
        until = manual["since"] + settings["hold_minutes"] * 60

    if state.get("on") is not True:
        return "light off", "the light is off; leaving it alone", False
    if sunrise_running():
        if send:
            memory["sunrise"] = now
        return "sunrise", "a sunrise is running; leaving it alone", False
    fresh = settings["fresh_start"] and memory.get("fresh")
    if fresh:
        until = None  # a fresh start is not held up by a setting made as the light came on
    if tracking_settings()["switch"]:
        # One switch, no timer: a setting made by hand turns sun tracking off
        # for everything, and it stays off until it is turned on again.
        track = tracking()
        # What a sunrise leaves behind is not a setting by hand; it is taken over.
        after_sunrise = manual is not None and manual["since"] <= memory.get("sunrise", 0) + 90
        if until is not None and track["on"] and manual["since"] > track["since"] and not after_sunrise:
            track = set_tracking(False, "light", describe(state), now) if send else dict(track, on=False)
        until = None  # a setting from before tracking was turned on is taken over
        if not track["on"] and not fresh:
            return "tracking off", "sun tracking is %s; leaving the light alone" % tracking_text(track), False
    if until is not None and now < until:
        at = time.strftime("%H:%M", time.localtime(until))
        return "hold " + at, "the light was set elsewhere (%s); following again at %s" % (describe(state), at), False

    sun = sundial_target(now)
    kelvin_now, output = follow_target(sun, settings)
    wanted = follow_look(plan_white(light.profile, state, kelvin_now, output)[1])
    wanted_text = "white %dK at %s" % (kelvin_now, percent_text(output))
    if look == wanted:
        if send:
            memory.pop("manual", None)
            memory["stamp"], memory["sent"] = stamp, look
            memory["fresh"] = False
        return "following", "following the sun; the light is already at %s" % wanted_text, False
    if not send:
        return "following", "%s; about to set %s" % (
            "fresh start" if fresh else "following the sun", wanted_text), False
    if state_stamp() != stamp:
        # Something else set the light a moment ago. Look again next minute.
        return memory.get("situation", "following"), None, False
    light.show_white(kelvin_now, output, 0, no_power=True)
    memory.pop("manual", None)
    memory["stamp"], memory["sent"] = state_stamp(), follow_look(light.state)
    if fresh:
        memory["fresh"], memory["fresh_at"] = False, now
        return "following", "fresh start: switched on, so set to the sun's %s" % wanted_text, True
    return "following", "sun %+.1f  %s" % (float(sun["sun_elevation"]), wanted_text), True


def fresh_outlook(settings, memory, on, now):
    """What `follow` says about fresh starts."""
    if not settings["fresh_start"]:
        return "switched off"
    if memory.get("fresh"):
        if in_night(settings, now):
            return "due in the morning, if the light is on then"
        return "due now" if on else "due: when the light is switched on it goes straight to the sun's setting"
    if memory.get("fresh_at") and now - memory["fresh_at"] < 12 * 3600:
        return "made at %s" % hhmm(memory["fresh_at"])
    return "none due"


def follow_apply(light, now=None, sunrise_running=sunrise_is_running):
    """One run of the follower. Returns the line to log, or None.

    A line is logged when the light is set and when the situation changes, so
    an outage or a hold is one line, not one a minute.
    """
    now = time.time() if now is None else now
    memory = read_json(FOLLOW_MEMORY_FILE, {})
    before = json.dumps(memory, sort_keys=True)
    try:
        situation, sentence, sent = follow_step(light, memory, now, True, sunrise_running)
    except Failure as failure:
        situation, sentence, sent = "stuck", "cannot follow the sun: %s" % failure, False
    changed = situation != memory.get("situation")
    memory["situation"] = situation
    if json.dumps(memory, sort_keys=True) != before:
        write_json(FOLLOW_MEMORY_FILE, memory)
    return sentence if sentence and (sent or changed) else None


def cmd_follow(light, args):
    light.quiet = True
    if args.action == "apply":
        # The minute timer runs this, so it must never fail loudly.
        try:
            line = follow_apply(light)
        except Exception as error:  # noqa: BLE001
            line = "unexpected error: %r" % (error,)
        if line:
            print("%s  %s" % (time.strftime("%F %T"), line), flush=True)
        return
    if args.action in ("on", "off"):
        saved = dict(FOLLOW_DEFAULTS)
        saved.update(read_json(FOLLOW_FILE, {}))
        saved["enabled"] = args.action == "on"
        write_json(FOLLOW_FILE, saved)
        if args.action == "off":
            print("following is off; the light stays as it is")
            return
        # Switching on also ends any hold on this light. The sun tracking
        # switch is left as it is: `neewer tracking on` is the one for that.
        memory = read_json(FOLLOW_MEMORY_FILE, {})
        memory.pop("manual", None)
        memory["stamp"], memory["sent"] = state_stamp(), follow_look(light.state)
        starting_now(memory, follow_settings(), light.state.get("on") is True, time.time())
        write_json(FOLLOW_MEMORY_FILE, memory)
        line = follow_apply(light)
        print("following is on" + (": " + line if line else ""))
        return
    settings = follow_settings()
    print("Following: %s (day %d%%, night %d%% at %dK, hold %g min)" % (
        "on" if settings["enabled"] else "off", settings["day_brightness"],
        settings["night_brightness"], settings["night_kelvin"], settings["hold_minutes"]))
    now = time.time()
    try:
        sun = sundial_target(now)
        print("Sun:       %+.1f degrees, daylight %d%%" % (
            float(sun["sun_elevation"]), round(float(sun["daylight"]) * 100)))
        kelvin_now, output = follow_target(sun, settings)
        text = "white %dK at %s" % (kelvin_now, percent_text(output))
        if light.profile["hybrid"]:
            look = plan_white(light.profile, light.state, kelvin_now, output)[1]
            text += " (%s %d)" % (look["curve"], look["brightness"])
        print("Target:    %s" % text)
    except Failure as failure:
        print("Sun:       unknown (%s)" % failure)
    print("Light:     %s" % describe(light.state, light.profile))
    print("Tracking:  %s" % tracking_text())
    print("Bedtime:   %s" % bedtime_outlook(light, settings, read_json(FOLLOW_MEMORY_FILE, {}), now))
    print("Fresh:     %s" % fresh_outlook(settings, read_json(FOLLOW_MEMORY_FILE, {}), light.state.get("on") is True, now))
    try:
        sentence = follow_step(light, read_json(FOLLOW_MEMORY_FILE, {}), now, send=False)[1]
    except Failure as failure:
        sentence = "cannot follow the sun: %s" % failure
    print("Now:       %s" % sentence)


def minutes(text):
    try:
        value = float(text)
    except ValueError:
        raise argparse.ArgumentTypeError("'%s' is not a number of minutes" % text)
    if not 0 < value <= 24 * 60:
        raise argparse.ArgumentTypeError("must be more than 0 and at most 1440")
    return value


def cmd_raw(light, args):
    try:
        frame = list(bytes.fromhex(args.hex.replace(" ", "").replace(":", "").replace(",", "")))
    except ValueError:
        raise Failure("'%s' is not hex" % args.hex)
    if not args.no_checksum:
        frame.append(checksum(frame))
    light.bridge.send(frame)
    light.say("sent " + to_hex(frame))


def duration(seconds):
    if seconds is None:
        return "?"
    minutes, seconds = divmod(int(seconds), 60)
    hours, minutes = divmod(minutes, 60)
    if hours:
        return "%d h %d min" % (hours, minutes)
    if minutes:
        return "%d min" % minutes
    return "%d s" % seconds


def cmd_status(light, args):
    status, info = light.bridge.json("GET", "/status")
    if args.json:
        print(json.dumps({"bridge": info, "last_set": light.state}, indent=2, sort_keys=True))
        return
    print("Bridge:    running (version %s), Bluetooth %s, permission %s" % (
        info.get("version"), info.get("bluetooth"), info.get("permission")))
    if info.get("connected"):
        signal = "signal unknown"
        if info.get("rssi") is not None:
            signal = "signal %s dBm, checked %s ago" % (info["rssi"], duration(info.get("rssiSecondsAgo")))
        print("Light:     connected to %s for %s (%s)" % (
            info.get("name"), duration(info.get("connectedSeconds")), signal))
    elif info.get("permission") != "allowed":
        print("Light:     not connected. Bluetooth permission is '%s'; allow Neewer Bridge in"
              " System Settings > Privacy & Security > Bluetooth." % info.get("permission"))
    else:
        print("Light:     not connected (%s). Check it is on and in Infinity mode." % (
            "scanning" if info.get("scanning") else "waiting"))
    print("Profile:   %s" % describe_profile(light.profile))
    print("Last set:  %s" % describe(light.state, light.profile))
    print("           (what this command last sent; changes made on the light itself are not seen)")


def cmd_replies(light, args):
    status, value = light.bridge.json("GET", "/replies")
    replies = value.get("replies", [])
    if not replies:
        print("the light has sent nothing back")
    for reply in replies:
        print("%4d  %6s ago  %s" % (reply["sequence"], duration(reply["secondsAgo"]), reply["hex"]))


def cmd_address(light, args):
    if args.address:
        parse_mac(args.address)
        light.settings["mac"] = args.address.upper().replace("-", ":")
        write_json(LIGHT_FILE, light.settings)
        print("saved " + light.settings["mac"])
        return
    if args.detect:
        found = addresses_known_to_macos()
        if not found:
            raise Failure("macOS has no Neewer light in its Bluetooth list; connect it first")
        for name, address in found:
            print("%s  %s" % (address, name))
        return
    print(light.settings.get("mac") or "not set")


def cmd_selftest(light, args):
    """Checks the frame builder against known-good frames.

    The first three are captures from other lights. The channels frame is the
    one confirmed by eye on this light, with the address swapped for a placeholder.
    """
    cases = [
        ("channels", channels_frame(parse_mac("AA:BB:CC:DD:EE:FF"), 1, warm=20), "78a90eaabbccddeeffa8010000000014" + "00" + "e7"),
        ("power on", power_frame(parse_mac("F7:AC:16:F1:58:96"), True), "788d08f7ac16f158968101" + "27"),
        ("white", white_frame(parse_mac("DF:24:3A:B4:46:5D"), 6500, 29, 50, "linear"), "78900bdf243ab4465d871d416404" + "f4"),
        ("colour", colour_frame(parse_mac("F7:AC:16:F1:58:96"), 69, 92, 50), "788f0cf7ac16f1589686" + "45005c3200" + "04"),
    ]
    failed = 0
    for name, frame, expected in cases:
        actual = to_hex(frame)
        ok = actual == expected
        failed += 0 if ok else 1
        print("%-9s %s  %s" % (name, "ok  " if ok else "FAIL", actual if ok else "%s != %s" % (actual, expected)))
    # The AS600B's profile: every white frame is kept inside 2700-6500K, which
    # the light takes, and carries its exponential curve (01). 6600K and 2500K
    # would be dropped by the light, so they become 6500K and 2700K.
    as600b = light_profile({"profile": {"model": "AS600B"}})
    mac = parse_mac("AA:BB:CC:DD:EE:FF")
    for name, wanted, expected in (("AS600B hi", 6600, 65), ("AS600B lo", 2500, 27)):
        frame = white_frame(mac, fit_kelvin(as600b, wanted), 5, 0, as600b["curve"])
        ok = frame[11] == expected and frame[13] == 0x01
        failed += 0 if ok else 1
        print("%-9s %s  %s" % (name, "ok  " if ok else "FAIL", to_hex(frame)))
    if failed:
        raise Failure("%d frame(s) do not match the captures" % failed)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="neewer", description="Control a Neewer Infinity light through the local Neewer Bridge.")
    parser.add_argument("--bridge", help="bridge address (default %s)" % DEFAULT_BRIDGE)
    parser.add_argument("--mac", help="the light's Bluetooth address, overriding the saved one")
    parser.add_argument("-q", "--quiet", action="store_true", help="print nothing on success")
    commands = parser.add_subparsers(dest="command", metavar="command")
    commands.required = True

    def add(name, function, help_text, aliases=()):
        sub = commands.add_parser(name, help=help_text, aliases=list(aliases))
        sub.set_defaults(function=function)
        return sub

    def add_no_power(sub):
        sub.add_argument("--no-power", action="store_true",
                         help="do not switch the light on first if it was last set off")

    add("on", cmd_on, "switch on")
    add("off", cmd_off, "switch to standby")

    white = add("white", cmd_white, "white light: neewer white 5600 10", aliases=["cct"])
    white.add_argument("kelvin", type=kelvin, help="colour temperature, within what the light shows (neewer status)")
    white.add_argument("brightness", type=output_percent, nargs="?",
                       help="light output 0-100, fractions allowed (default: last used)")
    white.add_argument("--tint", type=bounded(-50, 50, "tint"), help="green/magenta, -50 to 50")
    white.add_argument("--curve", choices=sorted(CURVES),
                       help="send the brightness as a raw setting on this curve, with no mapping")
    add_no_power(white)

    colour = add("colour", cmd_colour, "colour by hue: neewer colour 240 100 10", aliases=["color", "hsi"])
    colour.add_argument("hue", type=bounded(0, 360, "hue"), help="0-360")
    colour.add_argument("saturation", type=bounded(0, 100, "saturation"), help="0-100")
    colour.add_argument("brightness", type=whole_percent, nargs="?", help="0-100 (default: last used)")
    add_no_power(colour)

    rgb = add("rgb", cmd_rgb, "colour by hex: neewer rgb ff8800 10")
    rgb.add_argument("colour", type=rgb_hex, help="like ff8800")
    rgb.add_argument("brightness", type=whole_percent, nargs="?", help="0-100 (default: last used)")
    add_no_power(rgb)

    # argparse formats help text with %, so a literal percent sign is doubled.
    faint = add("faint", cmd_faint, "dimmer than 1%%: neewer faint 5 (level 1-255)")
    faint.add_argument("level", type=bounded(1, 255, "level"), help="1 (dimmest) to 255")
    faint.add_argument("--white", choices=["warm", "cold", "both"], default="warm",
                       help="which white LEDs to use (default: warm)")
    add_no_power(faint)

    channels = add("channels", cmd_channels, "drive the five LED channels: neewer channels 1 --warm 20")
    channels.add_argument("brightness", type=whole_percent, nargs="?", help="0-100 (default: last used)")
    for name in CHANNELS:
        channels.add_argument("--" + name, type=bounded(0, 255, name), default=0, help="0-255")
    add_no_power(channels)

    sunrise = add("sunrise", cmd_sunrise, "ramp up like a real sunrise: neewer sunrise --minutes 30")
    sunrise.add_argument("--minutes", type=minutes, default=30.0, help="how long the ramp takes (default 30)")
    sunrise.add_argument("--brightness", type=bounded(1, 100, "brightness"), default=100,
                         help="where the ramp ends, 1-100 (default 100)")
    sunrise.add_argument("--kelvin", type=kelvin, default=5600, help="colour temperature at the end (default 5600)")
    sunrise.add_argument("--style", choices=["sky", "glow"], default="sky",
                         help="sky follows the real sky's brightness (default); glow is the red-glow ramp")
    sunrise.add_argument("--plan", action="store_true", help="print the steps and send nothing")

    track = add("tracking", cmd_tracking, "the switch for everything that follows the sun: neewer tracking on")
    track.add_argument("action", nargs="?", choices=["on", "off", "status"], default="status")
    follow = add("follow", cmd_follow, "follow the sun through the day: neewer follow on")
    follow.add_argument("action", nargs="?", choices=["on", "off", "status", "apply"], default="status",
                        help="on, off, status (default), or apply: set the light once, as the minute timer does")

    brightness = add("brightness", cmd_brightness, "change brightness, keep the colour", aliases=["dim"])
    brightness.add_argument("brightness", type=output_percent, help="light output 0-100, fractions allowed")
    add_no_power(brightness)

    status = add("status", cmd_status, "show the bridge, the link and the last setting")
    status.add_argument("--json", action="store_true")

    raw = add("raw", cmd_raw, "send a frame given as hex; the checksum is added for you")
    raw.add_argument("hex")
    raw.add_argument("--no-checksum", action="store_true", help="send the bytes exactly as given")

    add("replies", cmd_replies, "show frames the light has sent back")

    address = add("address", cmd_address, "show, set or look up the light's Bluetooth address")
    address.add_argument("address", nargs="?")
    address.add_argument("--detect", action="store_true", help="list Neewer lights macOS knows")

    add("selftest", cmd_selftest, "check the frame builder against captured frames")
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        args.function(Light(args), args)
    except Failure as failure:
        print("neewer: %s" % failure, file=sys.stderr)
        return 1
    except BrokenPipeError:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
