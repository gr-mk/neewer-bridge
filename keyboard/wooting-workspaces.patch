+
+// The control file: ~/.local/state/wooting-workspaces/control, re-read every
+// CONTROL_SECS. Another program writes it (the desk's Apple Home service, to
+// make the keyboard follow the sun); this stays the only writer of the LEDs.
+//   on 1                 0 = every key dark
+//   brightness 0.35      0-1, scales every colour
+//   tint 1.0 0.66 0.35   0-1 for red, green, blue: a warmer white
+//   base ffffff          colour of the keys not coloured here, or "profile"
+// No file, or a line left out, means on, full brightness, no tint, profile:
+// exactly as without it. The firmware draws the profile and can't be dimmed
+// from here, so any base but "profile" overrides those keys too.
+#define CONTROL_SECS 1
+static char control_path[1024];
+static struct { int on, base; double brightness, tint[3]; } ctl = {1, PROFILE, 1, {1, 1, 1}};
+
+static double unit(double x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
+
+static void read_control(void) {
+  FILE *f = *control_path ? fopen(control_path, "r") : NULL;
+  char line[128];
+  ctl.on = 1;
+  ctl.base = PROFILE;
+  ctl.brightness = ctl.tint[0] = ctl.tint[1] = ctl.tint[2] = 1;
+  while (f && fgets(line, sizeof line, f)) {
+    double a, b, c;
+    unsigned hex;
+    if (sscanf(line, "on %lf", &a) == 1) ctl.on = a != 0;
+    else if (sscanf(line, "brightness %lf", &a) == 1) ctl.brightness = unit(a);
+    else if (sscanf(line, "tint %lf %lf %lf", &a, &b, &c) == 3)
+      ctl.tint[0] = unit(a), ctl.tint[1] = unit(b), ctl.tint[2] = unit(c);
+    else if (sscanf(line, "base %x", &hex) == 1) ctl.base = hex & 0xffffff; // "profile" isn't hex: stays PROFILE
+  }
+  if (f) fclose(f);
+}
+
+// A colour dimmed and tinted as the control file says. A lit channel stays
+// lit, so a dim workspace key never goes out.
+static int controlled(int colour) {
+  int out = 0;
+  for (int i = 0; i < 3; i++) {
+    int shift = 16 - 8 * i, v = (colour >> shift) & 0xff;
+    int s = (int)(v * ctl.brightness * ctl.tint[i] + 0.5);
+    if (v && !s && ctl.brightness > 0 && ctl.tint[i] > 0) s = 1;
+    out |= s << shift;
+  }
+  return out;
+}
 
