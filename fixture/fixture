#!/usr/bin/env python3
"""fixture: several WiZ bulbs in one light fitting, driven as one light.

Every change is sent to all the bulbs at once, over the WiZ local protocol
(JSON over UDP, port 38899). No cloud and no vendor app are involved.

    fixture on | off
    fixture white 2700 40       colour temperature in kelvin, brightness up to 100
    fixture colour 240 100 40   hue 0-360, saturation 0-100, brightness
    fixture brightness 12.5     keeps the colour; fractions are allowed
    fixture sweep 1.2 0.8       move slowly from one brightness to another
    fixture compare ...         set one bulb by hand, to match it against the rest by eye
    fixture status              asks every bulb what it is doing
    fixture discover            lists the WiZ bulbs on the network
    fixture follow              follow the sun: on, off, status, apply

Brightness is the average dimming of the bulbs. A whole number is every bulb
at that dimming. Fractions single some bulbs out, and white below 1% drives
the bulbs' white LEDs directly; see `split`, `PATTERNS` and `Fixture.raw`.
"""

import argparse
import colorsys
import contextlib
import errno
import fcntl
import json
import os
import socket
import sys
import threading
import time

VERSION = "1.0.0"
PORT = 38899

APP_DIR = os.environ.get("FIXTURE_DIR") or os.path.expanduser("~/Library/Application Support/LightFixture")
SUNDIAL_STATE_FILE = os.path.expanduser("~/.local/state/sundial/state.json")
SUNDIAL_STALE_SECONDS = 300

# How hard to try. Each try sends to every bulb that has not answered yet,
# then waits this long for answers. The bulbs save power between Wi-Fi beacons
# and often take a second or two to answer, so the waits are long.
WAITS = (0.5, 0.7, 1.0, 1.3)
SEARCH_ROUNDS = 4
SEARCH_WAIT = 0.5
SWEEP_EVERY = 600  # seconds between searches that ask every address

SETTINGS_DEFAULTS = {
    "name": "Fixture",          # the name shown in Apple Home
    "port": 51827,              # the Apple Home service's port
    "bulbs": [],                # MAC addresses
    "centre": "",               # the bulb in the middle of the fixture
    "ring": [],                 # the six around it, in order round the hexagon
    "ring_names": [],           # optional labels for the six ring places, e.g. "north"
    "layout_mapped": False,     # true once centre and ring are the real positions
    "min_dimming": 10,          # the lowest dimming a bulb takes as white
    "min_colour_dimming": 10,   # and as a colour
    "kelvin_min": 2700,
    "kelvin_max": 6500,
    # How white is made. "hybrid": the bulbs' own white from 1% up, and their
    # white LEDs driven directly ("raw") below 1%. "raw": driven directly at
    # every brightness.
    "white_mode": "hybrid",
    # Raw settings matched by eye against the bulbs' own white, one per line:
    #   {"kelvin": 2700, "percent": 1, "c": 0, "w": 42, "dimming": 10}
    # means: cold LED 0 and warm LED 42 at dimming 10 looks the same as white
    # 2700K at 1%. Empty means the bulbs are never driven directly.
    "raw_calibration": [],
    # While a slider is dragged in Apple Home: how many times a second the
    # newest setting is sent to the bulbs. 0 sends only when the bulbs have
    # answered the last one.
    "stream_rate": 10,
}
RAW_DIMMING = 10        # the dimming sent with raw LED levels; the bulbs take no less
RAW_WARM_KELVIN = 2700  # the warm white LED alone
RAW_COLD_KELVIN = 6500  # the cold white LED alone
DEFAULT_SETTING = {"on": False, "mode": "white", "kelvin": 2700, "brightness": 50.0, "hue": 0, "saturation": 100}

FOLLOW_DEFAULTS = {
    "enabled": True,
    "day_brightness": 100,   # brightness with the sun well up
    "night_brightness": 1,   # brightness after dark; above 0, so never off
    "night_kelvin": 2700,    # colour after dark
    "hold_minutes": 120,     # how long a setting made elsewhere is left alone
    "bedtime_rule": True,    # fade out and switch off at bedtime
    "morning_on": True,      # and switch on again before waking, if the rule switched it off
    "fade_minutes": 5,       # how long the fade at bedtime takes
    "morning_lead_minutes": 30,  # how long before the wake time it comes back on
    "bedtime": "",           # "23:00"; empty means sundial's
    "wake": "",              # "07:00"; empty means sundial's
}
SUNDIAL_CONFIG_FILE = os.path.expanduser("~/.config/sundial/config.ini")
# Bedtime is acted on only this soon after it. Later than that (the Mac was
# asleep, or the rule was only just installed) the night is left alone.
BEDTIME_GRACE_SECONDS = 15 * 60
FADE_STEP_SECONDS = 1.0
pause = time.sleep      # the fade waits with this, and
clock = time.monotonic  # measures with this; the tests replace both
# The colour moves from sundial's colour to the night colour while the sun goes
# from the horizon down to the end of civil twilight.
NIGHT_COLOUR_FROM, NIGHT_COLOUR_BY = 0.0, -6.0

LOCAL_NETWORK_HELP = (
    "macOS would not send to the local network (no route to host). If the Mac is on the "
    "network, allow this program under System Settings > Privacy & Security > Local Network")


class Failure(Exception):
    """Something the user should be told in one line."""


def path(name):
    return os.path.join(APP_DIR, name)


def read_json(file, fallback):
    try:
        with open(file) as handle:
            value = json.load(handle)
    except (OSError, ValueError):
        return fallback
    return value if isinstance(value, type(fallback)) else fallback


def write_json(file, value):
    os.makedirs(os.path.dirname(file), exist_ok=True)
    temporary = "%s.%d.tmp" % (file, os.getpid())
    with open(temporary, "w") as handle:
        json.dump(value, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.replace(temporary, file)


def clamp(low, value, high):
    return max(low, min(high, value))


def clean_mac(text):
    mac = "".join(c for c in str(text).lower() if c in "0123456789abcdef")
    if len(mac) != 12:
        raise Failure("'%s' is not a MAC address" % text)
    return mac


def settings():
    """fixture.json over the defaults; a value of the wrong kind is ignored."""
    given = read_json(path("fixture.json"), {})
    result = dict(SETTINGS_DEFAULTS)
    for key, default in SETTINGS_DEFAULTS.items():
        value = given.get(key, default)
        if type(value) is type(default):
            result[key] = value
    result["min_dimming"] = clamp(1, result["min_dimming"], 100)
    result["min_colour_dimming"] = clamp(1, result["min_colour_dimming"], 100)
    result["stream_rate"] = clamp(0, result["stream_rate"], 30)
    if result["white_mode"] not in ("hybrid", "raw"):
        result["white_mode"] = "hybrid"
    points = []
    for point in result["raw_calibration"]:
        try:
            point = {"kelvin": int(point["kelvin"]), "percent": float(point["percent"]), "c": int(point.get("c", 0)),
                     "w": int(point.get("w", 0)), "dimming": int(point.get("dimming", RAW_DIMMING))}
        except (AttributeError, KeyError, TypeError, ValueError):
            continue  # not a point
        if (point["percent"] > 0 and 0 <= point["c"] <= 255 and 0 <= point["w"] <= 255 and point["c"] + point["w"] > 0
                and RAW_DIMMING <= point["dimming"] <= 100):
            points.append(point)
    result["raw_calibration"] = points
    return result


# ---------------------------------------------------------------- brightness

# Which bulbs are singled out when only some of them are. The fixture is one
# bulb in the centre with six in a hexagon round it; "C" is the centre and the
# numbers are places round the ring. Each pattern is symmetric.
PATTERNS = {
    0: [],
    1: ["C"],
    2: [0, 3],              # an opposite pair
    3: [0, 2, 4],           # every other one: a triangle
    4: ["C", 0, 2, 4],
    5: ["C", 0, 1, 3, 4],   # two opposite pairs
    6: [0, 1, 2, 3, 4, 5],  # the whole ring, centre left out
    7: ["C", 0, 1, 2, 3, 4, 5],
}


def split(brightness, count, floor):
    """How to show a fixture brightness: (bulbs singled out, their dimming, the others' dimming).

    Brightness is the average dimming of the bulbs, and may be a fraction.
    It is taken in steps of one bulb at 1%: units = brightness x count.

      from the floor up   every bulb at the whole part, units // count, and
                          the left-over units go one each to the singled-out
                          bulbs, which are one step higher. A whole brightness
                          has none left over: every bulb is the same.
      below the floor     a bulb cannot go lower, so only the singled-out bulbs
                          are lit, each at the floor, and the others are off
                          (given here as dimming 0). As many are lit as come
                          nearest to the light asked for, and never none.
    """
    units = clamp(1, int(round(float(brightness) * count)), 100 * count)
    if units < floor * count:
        return clamp(1, int(units / float(floor) + 0.5), count), floor, 0
    return units % count, units // count + 1, units // count


def percent(brightness):
    """12.5 as "12.5%", 3.0 as "3%", 0.03 as "0.03%"."""
    text = "%.1f" % brightness if brightness >= 1 else "%.3f" % brightness
    return text.rstrip("0").rstrip(".") + "%"


def tidy(brightness):
    return clamp(0.001, round(float(brightness), 3), 100.0)


def hue_to_rgb(hue, saturation):
    red, green, blue = colorsys.hsv_to_rgb((hue % 360) / 360.0, clamp(0, saturation, 100) / 100.0, 1.0)
    return int(round(red * 255)), int(round(green * 255)), int(round(blue * 255))


def rgb_to_hue(red, green, blue):
    top = float(max(red, green, blue, 1))
    hue, saturation, _ = colorsys.rgb_to_hsv(red / top, green / top, blue / top)
    return int(round(hue * 360)) % 360, int(round(saturation * 100))


def pilot_look(pilot):
    """The part of a bulb's answer that says how it looks."""
    return {key: pilot[key] for key in ("sceneId", "temp", "r", "g", "b", "c", "w", "dimming") if pilot.get(key)}


def message_for(bulb):
    """The setPilot values that put a bulb in a recorded state."""
    values = dict(bulb["look"])
    if any(key in values for key in "rgb"):
        for key in "rgb":
            values.setdefault(key, 0)
    elif any(key in values for key in "cw"):
        for key in "cw":
            values.setdefault(key, 0)  # raw white: say both, so neither is left over
    values["state"] = bool(bulb["on"])
    return values


# ---------------------------------------------------------------- the network

def open_socket():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    return sock


def own_address():
    """This Mac's address on the home network, or None. Nothing is sent."""
    probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        probe.connect(("192.0.2.1", 9))
        return probe.getsockname()[0]
    except OSError:
        return None
    finally:
        probe.close()


def encode(method, values=None):
    return json.dumps({"method": method, "params": values or {}}, separators=(",", ":")).encode()


def decode(data):
    try:
        reply = json.loads(data)
    except ValueError:
        return {}
    return reply if isinstance(reply, dict) else {}


def exchange(method, values, absent=()):
    """Sends `method` to several addresses at once: {address: values}.

    Returns {address: result} for those that answered. All the packets of a
    try leave together. A bulb that does not answer is sent the same thing
    again. Addresses in `absent` are sent to but not waited for: they did not
    answer last time, and waiting for them would hold up every change.
    """
    answers = {}
    refused = 0
    patient = [address for address in values if address not in absent] or list(values)
    sock = open_socket()
    try:
        for wait in WAITS:
            waiting = [address for address in values if address not in answers]
            if all(address in answers for address in patient):
                break
            refused = 0
            for address in waiting:
                try:
                    sock.sendto(encode(method, values[address]), (address, PORT))
                except OSError as error:
                    refused += error.errno == errno.EHOSTUNREACH
            deadline = time.monotonic() + wait
            while not all(address in answers for address in patient):
                left = deadline - time.monotonic()
                if left <= 0:
                    break
                sock.settimeout(left)
                try:
                    data, sender = sock.recvfrom(4096)
                except OSError:
                    break
                reply = decode(data)
                if (sender[0] in values and sender[0] not in answers and reply.get("method") == method
                        and isinstance(reply.get("result"), dict)):
                    answers[sender[0]] = reply["result"]
    finally:
        sock.close()
    if values and not answers and refused == len(values):
        raise Failure(LOCAL_NETWORK_HELP)
    return answers


def search(hints=(), wanted=None, sweep=True):
    """Looks for WiZ bulbs on the network: {mac: (address, answer)}.

    Each round asks by broadcast. A bulb often misses a broadcast, so there are
    several rounds, and if bulbs are still missing every address of the local
    network is asked directly, twice. With `wanted`, a set of MAC addresses, the
    search stops as soon as all of them are found.
    """
    targets, sweeps = ["255.255.255.255"], []
    for address in [own_address()] + list(hints):
        if address:
            subnet = address.rsplit(".", 1)[0]
            if subnet + ".255" not in targets:
                targets.append(subnet + ".255")
                sweeps += ["%s.%d" % (subnet, host) for host in range(1, 255)]
    found = {}
    sock = open_socket()

    def done():
        return wanted is not None and all(mac in found for mac in wanted)

    try:
        for final in [False] * SEARCH_ROUNDS + [True, True]:
            if final and not sweep:
                break
            for target in sweeps if final else targets:
                try:
                    sock.sendto(encode("getPilot"), (target, PORT))
                except OSError:
                    pass
            # A bulb saving power can take most of a second to answer.
            deadline = time.monotonic() + SEARCH_WAIT * (2 if final else 1)
            while not done():
                left = deadline - time.monotonic()
                if left <= 0:
                    break
                sock.settimeout(left)
                try:
                    data, sender = sock.recvfrom(4096)
                except OSError:
                    break
                reply = decode(data)
                result = reply.get("result")
                if reply.get("method") == "getPilot" and isinstance(result, dict) and result.get("mac"):
                    found[result["mac"]] = (sender[0], result)
            if done():
                break
    finally:
        sock.close()
    return found


# ---------------------------------------------------------------- the fixture

class Fixture:
    """The bulbs as one light.

    state.json is the one record of what the fixture was last set to, shared
    by this command, the sun follower and the Apple Home service:

      setting   on, mode, kelvin, brightness, hue, saturation
      bulbs     what each bulb should be showing, by MAC address
      pending   bulbs that did not answer when that was sent
      by        who chose the look: cli, home, follow or elsewhere
      set_at    when

    The bulbs can be asked what they are doing, so a change made elsewhere
    (the WiZ app, a bulb's own tile in Apple Home) is noticed by `reconcile`.
    """

    def __init__(self):
        self.settings = settings()
        self.macs = [clean_mac(mac) for mac in self.settings["bulbs"]]
        if not self.macs:
            raise Failure("no bulbs are listed in %s; run: fixture discover --save" % path("fixture.json"))
        self.addresses = read_json(path("addresses.json"), {})
        self.search_every = 0   # seconds between searches for bulbs that stopped answering
        self.searched = None
        self.absent = set()     # bulbs that did not answer the last question
        self.thread_lock = threading.RLock()
        self.depth = 0
        self.lock_handle = None

    @contextlib.contextmanager
    def locked(self):
        """One program at a time talks to the bulbs and writes the record."""
        with self.thread_lock:
            if self.depth == 0:
                os.makedirs(APP_DIR, exist_ok=True)
                self.lock_handle = open(path("lock"), "w")
                fcntl.flock(self.lock_handle, fcntl.LOCK_EX)
            self.depth += 1
            try:
                yield
            finally:
                self.depth -= 1
                if self.depth == 0:
                    self.lock_handle.close()

    # -- limits

    def floor(self, mode):
        return self.settings["min_colour_dimming" if mode == "colour" else "min_dimming"]

    def kelvin(self, value):
        value = int(round(float(value) / 100.0)) * 100
        return clamp(self.settings["kelvin_min"], value, self.settings["kelvin_max"])

    # -- white from the raw LED levels
    #
    # Ordinary white stops at dimming 1. The bulbs' cold and warm white LEDs
    # can also be driven directly, at a dimming of 10 or more, and that goes far
    # lower. What raw setting looks like what white is known only where someone
    # compared the two by eye: the points in raw_calibration. Everything else
    # is worked out from those points, and `covered` says when it is a guess.

    def anchor(self):
        """(raw level, kelvin) that matches white at 1%, or None if there is no such point."""
        points = [point for point in self.settings["raw_calibration"]
                  if point["percent"] == 1 and point["dimming"] == RAW_DIMMING]
        if not points or self.floor("white") != 1:
            return None
        point = min(points, key=lambda point: abs(point["kelvin"] - RAW_WARM_KELVIN))
        return point["c"] + point["w"], point["kelvin"]

    def has_raw(self):
        # Without a matched level, or on bulbs whose dimming stops above 1,
        # white below the floor lights fewer bulbs instead, as a colour does.
        return self.anchor() is not None

    def cold_share(self, kelvin):
        """The cold LED's share of the raw level for a colour temperature.

        A measured point at this colour temperature decides it. Otherwise it
        is a guess: even steps in mireds from 2700K (all warm) to 6500K (all
        cold), and all warm below 2700K.
        """
        points = [point for point in self.settings["raw_calibration"] if point["kelvin"] == kelvin]
        if points:
            return points[0]["c"] / float(points[0]["c"] + points[0]["w"])
        warm, cold = 1e6 / RAW_WARM_KELVIN, 1e6 / RAW_COLD_KELVIN
        return clamp(0.0, (warm - 1e6 / kelvin) / (warm - cold), 1.0)

    def calibrated(self, kelvin, brightness):
        """(raw level, dimming, covered) for white at 1% or more, from raw_calibration.

        The light a raw setting gives is taken as level x dimming. Between two
        measured points of the nearest colour temperature, that and the dimming
        move evenly. Outside them it is a guess, in proportion to the nearest
        point; with only the 1% point that makes level 255 at dimming 100
        about 61%, which is probably too low, so expect to measure more points.
        `covered` is False for a guess.
        """
        table = self.settings["raw_calibration"]
        nearest = min((point["kelvin"] for point in table), key=lambda value: abs(value - kelvin))
        points = sorted((point["percent"], (point["c"] + point["w"]) * point["dimming"], point["dimming"])
                        for point in table if point["kelvin"] == nearest)
        low = max([point for point in points if point[0] <= brightness] or points[:1])
        high = min([point for point in points if point[0] >= brightness] or points[-1:])
        if low[0] < brightness < high[0]:
            along = (brightness - low[0]) / (high[0] - low[0])
            light, dimming = low[1] + (high[1] - low[1]) * along, low[2] + (high[2] - low[2]) * along
        else:
            near = low if brightness >= low[0] else high
            light, dimming = near[1] * brightness / near[0], near[2]
        # A level stops at 255; past that only more dimming gives more light.
        dimming = int(clamp(RAW_DIMMING, max(round(dimming), -(-light // 255)), 100))
        covered = nearest == kelvin and points[0][0] <= brightness <= points[-1][0]
        return min(255.0, light / dimming), dimming, covered

    def raw(self, setting):
        """How to show a white setting with the raw LED levels, or None for ordinary white.

        Returns units (the level wanted, in steps of one bulb: level x bulbs),
        dimming, share (the cold LED's part) and covered (False for a guess).

        Below 1% the level is the 1% point's level times the brightness, at
        dimming 10. At 1% and above ordinary white is used, unless white_mode
        is "raw", and then the level and dimming come from `calibrated`.
        """
        anchor = self.anchor()
        if setting["mode"] != "white" or anchor is None:
            return None
        always, count = self.settings["white_mode"] == "raw", len(self.macs)
        kelvin, brightness = setting["kelvin"], setting["brightness"]
        if brightness < 1:
            units, dimming = clamp(1, int(round(brightness * anchor[0] * count)), anchor[0] * count), RAW_DIMMING
            if units == anchor[0] * count and not always:
                return None  # the top step is 1% itself
            covered = kelvin == anchor[1]
        elif not always:
            return None
        else:
            level, dimming, covered = self.calibrated(kelvin, brightness)
            units = clamp(count, int(round(level * count)), 255 * count)
        return {"units": units, "dimming": dimming, "share": self.cold_share(kelvin), "covered": covered}

    @staticmethod
    def raw_look(level, raw):
        """One bulb's raw LED levels: the level shared between the cold and warm LEDs."""
        cool = int(round(level * raw["share"]))
        return pilot_look({"c": cool, "w": level - cool, "dimming": raw["dimming"]})

    def split(self, setting):
        """(bulbs singled out, their level, the others' level); 0 is off.

        The levels are raw LED levels when `raw` says so, dimming otherwise.
        """
        raw, count = self.raw(setting), len(self.macs)
        if raw is None:
            brightness = setting["brightness"]
            if self.has_raw() and setting["mode"] == "white":
                brightness = max(1, brightness)  # the top raw step is 1% itself
            return split(brightness, count, self.floor(setting["mode"]))
        if raw["units"] < count:
            return raw["units"], 1, 0  # below every bulb at level 1: fewer bulbs
        return raw["units"] % count, raw["units"] // count + 1, raw["units"] // count

    def look(self, setting):
        """The part of a setting that says how the fixture looks. Power is left out."""
        units = int(round(setting["brightness"] * len(self.macs)))
        if setting["mode"] == "colour":
            return ("colour", setting["hue"], setting["saturation"], units)
        raw = self.raw(setting)
        return ("white", setting["kelvin"], units, raw and (raw["units"], raw["dimming"]))

    def layout(self):
        """(centre, ring) from fixture.json, read afresh so an edit takes effect.

        Without a full layout there (a centre and six ring bulbs, all of them
        the fixture's own), the list order stands in: first the centre, then
        the ring.
        """
        given = settings()
        try:
            centre, ring = clean_mac(given["centre"]), [clean_mac(mac) for mac in given["ring"]]
        except Failure:
            centre, ring = None, []
        if sorted([centre] + ring) != sorted(self.macs):
            centre, ring = self.macs[0], self.macs[1:]
        return centre, ring

    def singled(self, number):
        """The bulbs singled out when `number` of them are, by PATTERNS."""
        if len(self.macs) != 7:
            return self.macs[:number]  # no hexagon: simply the first in the list
        centre, ring = self.layout()
        return [centre if place == "C" else ring[place] for place in PATTERNS[number]]

    def lit(self, setting):
        number, _, others = self.split(setting)
        return len(self.macs) if others else number

    def describe(self, setting):
        if setting["mode"] == "colour":
            text = "colour hue %d sat %d at %s" % (setting["hue"], setting["saturation"], percent(setting["brightness"]))
        else:
            text = "white %dK at %s" % (setting["kelvin"], percent(setting["brightness"]))
        notes = []
        raw = self.raw(setting)
        if raw is not None:
            level = max(1.0, raw["units"] / float(len(self.macs)))
            notes.append("raw %s %s%s" % ("warm" if raw["share"] == 0 else "white",
                                          ("%.1f" % level).rstrip("0").rstrip("."),
                                          " at dimming %d" % raw["dimming"] if raw["dimming"] != RAW_DIMMING else ""))
        if self.lit(setting) < len(self.macs):
            notes.append("%d of %d bulbs lit" % (self.lit(setting), len(self.macs)))
        if notes:
            text += " (%s)" % ", ".join(notes)
        return text if setting["on"] else "off (%s)" % text

    def describe_bulbs(self, setting):
        number, level, others = self.split(setting)
        form = "raw %d" if self.raw(setting) is not None else "%d%%"
        if not others:
            return ("%d of %d bulbs at " + form + ", the rest off") % (number, len(self.macs), level) \
                if number < len(self.macs) else ("all %d bulbs at " + form) % (number, level)
        if not number:
            return ("all %d bulbs at " + form) % (len(self.macs), others)
        return ("%d bulb%s at " + form + ", %d at " + form) % (
            number, "" if number == 1 else "s", level, len(self.macs) - number, others)

    # -- the record

    def state(self):
        raw = read_json(path("state.json"), {})
        given = raw.get("setting") if isinstance(raw.get("setting"), dict) else {}
        setting = dict(DEFAULT_SETTING)
        for key, default in DEFAULT_SETTING.items():
            if type(given.get(key)) is type(default):
                setting[key] = given[key]
        if isinstance(given.get("brightness"), (int, float)) and not isinstance(given.get("brightness"), bool):
            setting["brightness"] = tidy(given["brightness"])
        bulbs = raw.get("bulbs") if isinstance(raw.get("bulbs"), dict) else {}
        return {
            "setting": setting,
            "bulbs": {mac: bulbs[mac] for mac in self.macs if isinstance(bulbs.get(mac), dict)},
            "pending": [mac for mac in raw.get("pending", []) if mac in self.macs],
            "by": raw.get("by") or "elsewhere",
            "set_at": float(raw.get("set_at") or 0),
        }

    def plan(self, setting):
        """What each bulb should show for a setting: {mac: {"on", "look"}}.

        Bulbs that are switched off are still given the look, so they show
        the right thing if the wall switch brings them back on.
        """
        # fixture.json is read afresh, so a new calibration point or white_mode
        # takes effect without starting anything again.
        self.settings = settings()
        number, dimming, others = self.split(setting)
        singled = self.singled(number)
        raw = self.raw(setting)
        if raw is not None:
            return {mac: {"on": bool(setting["on"]) and (mac in singled or others > 0),
                          # A bulb kept off is at level 1, ready to be lit.
                          "look": self.raw_look((dimming if mac in singled else others) or 1, raw)}
                    for mac in self.macs}
        if setting["mode"] == "colour":
            red, green, blue = hue_to_rgb(setting["hue"], setting["saturation"])
            look = pilot_look({"r": red, "g": green, "b": blue})
        else:
            look = {"temp": setting["kelvin"]}
        bulbs = {}
        for mac in self.macs:
            level = dimming if mac in singled else others
            # A bulb kept off is at the floor, ready to be lit.
            bulbs[mac] = {"on": bool(setting["on"]) and level > 0,
                          "look": dict(look, dimming=level or self.floor(setting["mode"]))}
        return bulbs

    # -- talking to the bulbs

    def read_all(self):
        """Asks every bulb what it is doing: {mac: answer, or None if it did not answer}.

        Bulbs are known by MAC address. Their network addresses are remembered,
        and looked for again when a bulb stops answering, since the router may
        move them.
        """
        asked = {self.addresses[mac]: mac for mac in self.macs if mac in self.addresses}
        answers = exchange("getPilot", {address: {} for address in asked}) if asked else {}
        pilots = {}
        for address, mac in asked.items():
            if answers.get(address, {}).get("mac") == mac:
                pilots[mac] = answers[address]
            elif address in answers:
                del self.addresses[mac]  # another bulb has this address now
        missing = [mac for mac in self.macs if mac not in pilots]
        now = time.monotonic()
        if missing and (self.searched is None or now - self.searched >= self.search_every):
            self.searched = now
            found = search(self.addresses.values(), set(missing), self.may_sweep())
            moved = False
            for mac in missing:
                if mac in found:
                    moved = moved or self.addresses.get(mac) != found[mac][0]
                    self.addresses[mac], pilots[mac] = found[mac]
            if moved:
                write_json(path("addresses.json"), self.addresses)
        self.absent = {mac for mac in self.macs if mac not in pilots}
        return {mac: pilots.get(mac) for mac in self.macs}

    @staticmethod
    def may_sweep():
        """True at most once in a while, whichever program asks."""
        try:
            if abs(time.time() - os.stat(path("swept")).st_mtime) < SWEEP_EVERY:
                return False
        except OSError:
            pass
        os.makedirs(APP_DIR, exist_ok=True)
        with open(path("swept"), "w"):
            pass
        return True

    def send(self, bulbs):
        """Sends each bulb its state: {mac: {"on", "look"}}. Returns the MACs that acknowledged."""
        values = {self.addresses[mac]: message_for(bulb) for mac, bulb in bulbs.items() if mac in self.addresses}
        absent = [self.addresses[mac] for mac in self.absent if mac in self.addresses]
        answers = exchange("setPilot", values, absent) if values else {}
        return {mac for mac in bulbs if answers.get(self.addresses.get(mac), {}).get("success") is True}

    def stream(self, setting, sock):
        """Sends a setting to every bulb without waiting for answers or writing the record.

        For a run of settings in quick succession, each replacing the last. A
        bulb that misses one gets the next. The run must end with `apply`.
        """
        while True:  # throw away the answers to earlier sends
            sock.settimeout(0)
            try:
                sock.recvfrom(4096)
            except OSError:
                break
        for mac, bulb in self.plan(setting).items():
            if mac in self.addresses:
                try:
                    sock.sendto(encode("setPilot", message_for(bulb)), (self.addresses[mac], PORT))
                except OSError:
                    pass

    def apply(self, setting, by):
        """Sets the whole fixture. Returns the MACs of bulbs that did not take it."""
        with self.locked():
            if any(mac not in self.addresses for mac in self.macs):
                self.read_all()  # finds the bulbs
            state = self.state()
            bulbs = self.plan(setting)
            taken = self.send(bulbs)
            if not taken:
                raise Failure("no bulb answers; is the fixture switched on at the wall?")
            setting = dict(setting, brightness=tidy(setting["brightness"]))
            if self.look(setting) != self.look(state["setting"]) or not state["bulbs"]:
                state["by"], state["set_at"] = by, time.time()
            state.update(setting=dict(setting), bulbs=bulbs, pending=[mac for mac in self.macs if mac not in taken])
            write_json(path("state.json"), state)
            return state["pending"]

    def claim(self, by):
        """Marks the present look as chosen by `by`, without sending anything."""
        with self.locked():
            state = self.state()
            state["by"], state["set_at"] = by, time.time()
            write_json(path("state.json"), state)

    def reconcile(self, dry=False):
        """Compares the bulbs with the record and settles any difference.

        Returns (state, answers). Unless `dry`, the record is brought up to
        date, and bulbs that missed the last setting are sent it.
        """
        # The bulbs are slow to answer, so they are asked before taking the
        # lock. If the record changed meanwhile, the answers may be from before
        # that change, and are left for the next look.
        record = self.state()
        pilots = self.read_all()
        seen = {mac: pilot for mac, pilot in pilots.items() if pilot}
        if not seen:
            raise Failure("no bulb answers; is the fixture switched on at the wall?")
        with self.locked():
            before = self.state()
            if before != record and self.depth == 1:
                return before, pilots
            state = self.settle(json.loads(json.dumps(before)), seen, dry)
            if state != before and not dry:
                write_json(path("state.json"), state)
            return state, pilots

    def settle(self, state, seen, dry):
        setting, bulbs = state["setting"], state["bulbs"]
        actual = {mac: {"on": bool(pilot.get("state")), "look": pilot_look(pilot)} for mac, pilot in seen.items()}

        def matches(mac):
            # A bulb that is off has no look to compare.
            want, have = bulbs.get(mac), actual[mac]
            return want is not None and want["on"] == have["on"] and (not have["on"] or want["look"] == have["look"])

        differing = [mac for mac in actual if not matches(mac)]
        waiting = [mac for mac in state["pending"] if mac not in actual]
        late = [mac for mac in differing if mac in state["pending"]]
        if not differing:
            state["pending"] = waiting
            return state
        if len(late) == len(differing):
            # These bulbs were out of reach when the setting was sent. Send it now.
            taken = set() if dry else self.send({mac: bulbs[mac] for mac in late})
            state["pending"] = waiting + [mac for mac in late if mac not in taken]
            return state

        state["pending"] = waiting
        lit = [mac for mac in actual if actual[mac]["on"]]
        if not lit:
            # The whole fixture was switched off elsewhere. Not a new setting.
            setting["on"] = False
            for mac in actual:
                bulbs[mac] = {"on": False, "look": bulbs.get(mac, actual[mac])["look"]}
            return state
        planned = self.plan(dict(setting, on=True))
        if all(actual[mac]["look"] == planned[mac]["look"] for mac in lit):
            # Only the power differs, so this is the same setting switched on.
            if set(lit) == {mac for mac in actual if planned[mac]["on"]}:
                setting["on"] = True
                state["bulbs"] = planned
                return state
            if len(lit) == len(actual):
                # Every bulb is lit: the power came back at the wall. Switch
                # off again the bulbs that a low brightness keeps off.
                taken = set(actual) if dry else self.send({mac: planned[mac] for mac in actual})
                setting["on"] = True
                state["bulbs"] = planned
                state["pending"] = waiting + [mac for mac in actual if mac not in taken]
                return state
        # Set elsewhere: take the bulbs as they are.
        state["setting"] = self.infer(actual, setting)
        bulbs.update(actual)
        state["by"], state["set_at"] = "elsewhere", time.time()
        return state

    def infer(self, actual, old):
        """The fixture setting that best describes bulbs set one by one."""
        setting = dict(old, on=True)
        looks = [bulb["look"] for bulb in actual.values() if bulb["on"]]
        temperatures = [look["temp"] for look in looks if "temp" in look]
        coloured = [look for look in looks if any(key in look for key in "rgb")]
        if temperatures and len(temperatures) * 2 >= len(looks):
            setting["mode"] = "white"
            setting["kelvin"] = int(max(set(temperatures), key=temperatures.count))
        elif coloured:
            setting["mode"] = "colour"
            setting["hue"], setting["saturation"] = rgb_to_hue(
                coloured[0].get("r", 0), coloured[0].get("g", 0), coloured[0].get("b", 0))
        # Brightness is the average over every bulb seen; one that is off counts as 0.
        # A bulb on its raw white LEDs counts by the level that matches 1%.
        top = float((self.anchor() or (0, 0))[0])

        def share(look):
            if top and "temp" not in look and not any(key in look for key in "rgb") and ("c" in look or "w" in look):
                return (look.get("c", 0) + look.get("w", 0)) / top * look.get("dimming", 100) / RAW_DIMMING
            return look.get("dimming", 100)
        setting["brightness"] = tidy(sum(share(look) for look in looks) / float(len(actual)))
        if setting["mode"] != "colour" and not temperatures:
            setting["mode"] = "white"  # raw white, set elsewhere; the colour temperature is not known
        return setting


# ---------------------------------------------------------------- follow the sun

# `fixture follow apply` runs once a minute and sets the fixture from the sun.
# It does not work the sun out itself. sundial, the program that does the same
# job for the monitors, writes the sun's height and its own target to a file
# every minute, and this reads that file.

def follow_settings():
    """follow.json over the defaults; a value of the wrong kind is ignored."""
    given = read_json(path("follow.json"), {})
    result = dict(FOLLOW_DEFAULTS)
    for key, default in FOLLOW_DEFAULTS.items():
        value = given.get(key, default)
        if isinstance(default, bool):
            good = isinstance(value, bool)
        elif isinstance(default, str):
            good = isinstance(value, str)
        else:
            good = isinstance(value, (int, float)) and not isinstance(value, bool)
        if good:
            result[key] = value
    result["fade_minutes"] = max(0, result["fade_minutes"])
    result["morning_lead_minutes"] = max(0, result["morning_lead_minutes"])
    result["night_brightness"] = clamp(0.001, float(result["night_brightness"]), 100.0)
    result["day_brightness"] = clamp(result["night_brightness"], float(result["day_brightness"]), 100.0)
    result["hold_minutes"] = max(0, result["hold_minutes"])
    return result


def follow_target(sun, follow, fixture):
    """(kelvin, brightness) for the fixture, from sundial's target.

    Brightness runs from the night level to the day level with sundial's
    "daylight" share, and is not rounded to a whole number: between whole
    percentages the fixture moves one bulb at a time. Colour is sundial's, moving to the night colour as the
    sun goes below the horizon, and kept inside what the bulbs can show.
    """
    daylight = clamp(0.0, float(sun["daylight"]), 1.0)
    low, high = follow["night_brightness"], follow["day_brightness"]
    brightness = round(low + (high - low) * daylight, 3)
    night = (NIGHT_COLOUR_FROM - float(sun["sun_elevation"])) / (NIGHT_COLOUR_FROM - NIGHT_COLOUR_BY)
    night = clamp(0.0, night, 1.0)
    colour = float(sun["kelvin"]) + (follow["night_kelvin"] - float(sun["kelvin"])) * night
    return fixture.kelvin(colour), clamp(0.001, brightness, 100.0)


def sundial_target(now):
    """What sundial last worked out, or a Failure if it is missing or old."""
    try:
        age = now - os.stat(SUNDIAL_STATE_FILE).st_mtime
    except OSError:
        raise Failure("sundial has written no state file (%s)" % SUNDIAL_STATE_FILE)
    if age > SUNDIAL_STALE_SECONDS:
        raise Failure("sundial last ran %d minutes ago" % (age // 60))
    sun = read_json(SUNDIAL_STATE_FILE, {}).get("target")
    try:
        float(sun["daylight"]), float(sun["sun_elevation"]), float(sun["kelvin"])
    except (KeyError, TypeError, ValueError):
        raise Failure("sundial's state file has no usable target")
    return sun


# ---------------------------------------------------------------- bedtime
#
# The one place the follower switches the fixture off and on. At bedtime it
# fades the fixture out and switches it off, once. Before the wake time it
# switches it on again, if it was the one that switched it off. Anything done
# by hand in between is left alone until morning.
#
# memory["night"] is what it knows about the present night:
#   start   when this night's bedtime was
#   state   "off": the follower switched the fixture off
#           "skip": the night is left alone
#           "done": the morning has been dealt with

def clock_minutes(text):
    """"23:00" as minutes after midnight, or None."""
    try:
        hours, minutes = str(text).strip().split(":")
        hours, minutes = int(hours), int(minutes)
    except ValueError:
        return None
    return hours * 60 + minutes if 0 <= hours < 24 and 0 <= minutes < 60 else None


def sleep_times(settings):
    """(bedtime, wake) in minutes after midnight, or None if either is unknown.

    follow.json's own "bedtime" and "wake" win. Otherwise they are sundial's,
    read from its settings file each time, so there is one place to change them.
    """
    import configparser
    sundial = configparser.ConfigParser(inline_comment_prefixes=("#", ";"))
    try:
        sundial.read(SUNDIAL_CONFIG_FILE)
    except configparser.Error:
        pass
    times = []
    for key in ("bedtime", "wake"):
        minutes = clock_minutes(settings[key])
        if minutes is None:
            minutes = clock_minutes(sundial.get("sleep", key, fallback=""))
        times.append(minutes)
    return None if None in times else tuple(times)


def night_window(now, bedtime, wake, lead_minutes):
    """(start, morning): the latest bedtime that has passed, and when that night ends.

    The night ends `lead_minutes` before the first wake time after it. From
    then until the next bedtime it is day.
    """
    today = time.localtime(now)

    def at(day, minutes):
        return time.mktime((today.tm_year, today.tm_mon, today.tm_mday + day, minutes // 60, minutes % 60, 0, 0, 0, -1))
    start = max(moment for moment in (at(-1, bedtime), at(0, bedtime)) if moment <= now)
    woke = min(moment for moment in (at(-1, wake), at(0, wake), at(1, wake)) if moment > start)
    return start, max(start, woke - lead_minutes * 60)


def hhmm(moment):
    return time.strftime("%H:%M", time.localtime(moment))


def night_sentence(night, on, morning, settings):
    if night["state"] == "off":
        return "off for the night; on at %s" % hhmm(morning) if settings["morning_on"] else "off for the night"
    if not on:
        return "off by hand; left alone tonight"
    if night.get("since"):
        return "on by hand since %s; left alone tonight" % hhmm(night["since"])
    return "on by hand; left alone tonight"


def night_situation(sentence):
    # One log line for each thing the night turns into, not one a minute.
    return "night: " + sentence.split(";")[0]


def bedtime_step(fixture, memory, follow, state, now, send):
    """The bedtime rule's part of one run. None means: carry on following.

    "fade" means: fade out now (done outside the lock, as it takes minutes).
    Otherwise (situation, sentence, sent), as follow_step returns.
    """
    times = sleep_times(follow) if follow["bedtime_rule"] else None
    if times is None:
        memory.pop("night", None)
        return None
    start, morning = night_window(now, times[0], times[1], follow["morning_lead_minutes"])
    night = memory.get("night")
    if not isinstance(night, dict) or night.get("start") != start:
        night = None
    setting, on = state["setting"], state["setting"]["on"]

    if now >= morning:
        # Day. Switch on once, if the follower was the one that switched off.
        if night is None or night["state"] != "off":
            return None
        if on or not follow["morning_on"]:
            if send:
                memory["night"] = dict(night, state="done")
            return None
        if not send:
            return "morning", "about to switch on for the morning", False
        kelvin, brightness = follow_target(sundial_target(now), follow, fixture)
        wanted = dict(setting, on=True, mode="white", kelvin=kelvin, brightness=brightness)
        missed = fixture.apply(wanted, "follow")
        fixture.claim("follow")
        memory["night"] = dict(night, state="done")
        return "following", "morning: switched on at %s%s" % (
            fixture.describe(wanted), "; not answering: %s" % ", ".join(missed) if missed else ""), True

    if night is None:
        # Bedtime has come. It is acted on once, and only close to the time.
        if now - start > BEDTIME_GRACE_SECONDS:
            night = {"start": start, "state": "skip", "why": "late"}
        elif not on:
            night = {"start": start, "state": "skip", "why": "off"}
        elif not send:
            return "bedtime", "about to fade out and switch off for the night", False
        else:
            return "fade"
        if send:
            memory["night"] = night
    if night["state"] == "off" and on:
        # Switched back on by hand. Left alone; it is not switched off twice.
        night = {"start": start, "state": "skip", "why": "hand", "since": now}
        if send:
            memory["night"] = night
    if night["state"] == "skip" and night.get("why") == "off" and on:
        night = dict(night, why="hand", since=now)
        if send:
            memory["night"] = night
    sentence = night_sentence(night, on, morning, follow)
    return night_situation(sentence), sentence, False


def bedtime_fade(fixture, memory, follow, now):
    """Fades out and switches off, then says what happened, as follow_step returns."""
    times = sleep_times(follow)
    start, morning = night_window(now, times[0], times[1], follow["morning_lead_minutes"])
    began = clock()
    finished = fade_out(fixture, follow["fade_minutes"] * 60.0)
    ended = now + (clock() - began)
    if finished:
        memory["night"] = night = {"start": start, "state": "off", "at": ended}
        sentence = night_sentence(night, False, morning, follow)
        return night_situation(sentence), "bedtime: faded out and switched off; " + sentence, True
    # Set by someone during the fade: theirs now.
    memory["night"] = night = {"start": start, "state": "skip", "why": "hand", "since": ended}
    sentence = night_sentence(night, fixture.state()["setting"]["on"], morning, follow)
    return night_situation(sentence), sentence, True


def fade_out(fixture, seconds):
    """Fades the fixture down to its lowest and switches every bulb off. True if it did.

    It stops, leaving the fixture as it is, if anything else sets it meanwhile.
    White goes down through the raw levels, to one bulb at its lowest. The
    record keeps the setting from before the fade, and the bulbs are given it
    as they are switched off, so switching on by hand brings that back and not
    the fade's last step.
    """
    def mark():
        state = fixture.state()
        return state["setting"], state["by"], state["set_at"]
    before = fixture.state()["setting"]
    top = before["brightness"]
    if before["mode"] == "white" and fixture.has_raw():
        low = 1.0 / (fixture.anchor()[0] * len(fixture.macs))
    else:
        low = fixture.floor(before["mode"]) / float(len(fixture.macs))
    mine, shown, began = mark(), fixture.plan(before), clock()
    while top > low and clock() - began < seconds:
        pause(FADE_STEP_SECONDS)
        if mark() != mine:
            return False
        # Each step is the same share dimmer than the last, which looks even.
        share = min(1.0, (clock() - began) / seconds)
        setting = dict(before, brightness=tidy(top * (low / top) ** share))
        bulbs = fixture.plan(setting)
        if bulbs != shown:
            fixture.apply(setting, "follow")
            mine, shown = mark(), bulbs
    if mark() != mine:
        return False
    fixture.apply(dict(before, on=False), "follow")
    return True


def bedtime_outlook(fixture, follow, memory, on, now):
    """What the bedtime rule will do next, for `fixture follow`."""
    if not follow["bedtime_rule"]:
        return "the rule is switched off"
    times = sleep_times(follow)
    if times is None:
        return "no bedtime known; set bedtime and wake in follow.json, or [sleep] in sundial's settings"
    start, morning = night_window(now, times[0], times[1], follow["morning_lead_minutes"])
    night = memory.get("night")
    if not isinstance(night, dict) or night.get("start") != start:
        night = None
    if now < morning and night is not None and night["state"] in ("off", "skip"):
        return night_sentence(night, on, morning, follow)
    if now < morning and night is None:
        return "bedtime was %s; fading out now" % hhmm(start) if now - start <= BEDTIME_GRACE_SECONDS \
            else "on by hand; left alone tonight" if on else "off by hand; left alone tonight"
    if night is not None and night["state"] == "off" and follow["morning_on"]:
        return "switching on for the morning"
    following = night_window(now + 86400, times[0], times[1], follow["morning_lead_minutes"])
    text = "off at %02d:%02d" % (times[0] // 60, times[0] % 60)
    if follow["morning_on"]:
        text += ", on again at %s" % hhmm(following[1])
    return text


def follow_step(fixture, now, send=True, memory=None):
    """Decides what to do this minute and, if `send`, does it.

    Returns (situation, sentence, sent). `memory` is what the follower keeps
    between runs, and is updated in place.
    """
    memory = {} if memory is None else memory
    follow = follow_settings()
    if not follow["enabled"]:
        return "off", "following is switched off", False
    with fixture.locked():
        state, _ = fixture.reconcile(dry=not send)
        verdict = bedtime_step(fixture, memory, follow, state, now, send)
        if verdict is None:
            return follow_sun(fixture, follow, state, now, send)
        if verdict != "fade":
            return verdict
    return bedtime_fade(fixture, memory, follow, now)


def follow_sun(fixture, follow, state, now, send):
    """The ordinary minute: set the fixture from the sun, unless it is off or held."""
    setting = state["setting"]
    if not setting["on"]:
        return "light off", "the fixture is off; leaving it alone", False
    # Whose setting is this? Anyone's but the follower's is left alone for a while.
    mine = state["by"] == "follow"
    until = state["set_at"] + follow["hold_minutes"] * 60
    if not mine and now < until:
        at = time.strftime("%H:%M", time.localtime(until))
        return "hold " + at, "the fixture was set elsewhere (%s); following again at %s" % (
            fixture.describe(setting), at), False

    sun = sundial_target(now)
    kelvin, brightness = follow_target(sun, follow, fixture)
    wanted = dict(setting, mode="white", kelvin=kelvin, brightness=brightness)
    text = fixture.describe(dict(wanted, on=True))
    # Only what the bulbs would show counts: a target that moved by less
    # than one bulb's step is not sent.
    if state["bulbs"] == fixture.plan(wanted):
        if send and not mine:
            fixture.claim("follow")
        return "following", "following the sun; the fixture is already at %s" % text, False
    if not send:
        return "following", "following the sun; about to set %s" % text, False
    missed = fixture.apply(wanted, "follow")
    fixture.claim("follow")
    if missed:
        text += "; not answering: %s" % ", ".join(missed)
    return "following", "sun %+.1f  %s" % (float(sun["sun_elevation"]), text), True


def follow_apply(fixture, now=None):
    """One run of the follower. Returns the line to log, or None.

    A line is logged when the fixture is set and when the situation changes,
    so an outage or a hold is one line, not one a minute.
    """
    now = time.time() if now is None else now
    memory = read_json(path("follow-state.json"), {})
    before = json.dumps(memory, sort_keys=True)
    try:
        situation, sentence, sent = follow_step(fixture, now, True, memory)
    except Failure as failure:
        situation, sentence, sent = "stuck", "cannot follow the sun: %s" % failure, False
    changed = situation != memory.get("situation")
    memory["situation"] = situation
    if json.dumps(memory, sort_keys=True) != before:
        write_json(path("follow-state.json"), memory)
    return sentence if sent or changed else None


# ---------------------------------------------------------------- commands

def whole(low, high, what):
    def parse(text):
        try:
            value = int(text)
        except ValueError:
            raise argparse.ArgumentTypeError("%s must be a whole number" % what)
        if not low <= value <= high:
            raise argparse.ArgumentTypeError("%s must be %d-%d" % (what, low, high))
        return value
    return parse


def set_fixture(fixture, **changes):
    with fixture.locked():
        state, _ = fixture.reconcile()
        setting = dict(state["setting"], **changes)
        missed = fixture.apply(setting, "cli")
    setting = fixture.state()["setting"]
    print("%s: %s" % (fixture.describe(setting), fixture.describe_bulbs(setting) if setting["on"] else "all bulbs off"))
    if missed:
        print("fixture: not answering: %s" % ", ".join(missed), file=sys.stderr)


def cmd_on(fixture, args):
    set_fixture(fixture, on=True)


def cmd_off(fixture, args):
    set_fixture(fixture, on=False)


def cmd_white(fixture, args):
    low, high = fixture.settings["kelvin_min"], fixture.settings["kelvin_max"]
    if not low <= args.kelvin <= high:
        raise Failure("these bulbs show %d-%dK" % (low, high))
    set_fixture(fixture, on=True, mode="white", kelvin=fixture.kelvin(args.kelvin), brightness=args.brightness)


def cmd_colour(fixture, args):
    set_fixture(fixture, on=True, mode="colour", hue=args.hue % 360, saturation=args.saturation,
                brightness=args.brightness)


def cmd_brightness(fixture, args):
    set_fixture(fixture, on=True, brightness=args.brightness)


def cmd_fade(fixture, args):
    """Shows, or tries to set, how long the bulbs themselves take to change.

    Each bulb fades to a new setting over its own saved time (fadeIn going
    brighter, fadeOut going dimmer). The bulbs this was written for refuse the
    change over the local network ("Invalid Request"), so it is checked by
    reading it back, and a refusal is said plainly.
    """
    fixture.read_all()  # finds the bulbs
    addresses = {fixture.addresses[mac]: mac for mac in fixture.macs if mac in fixture.addresses}
    if args.milliseconds is not None:
        values = {"fadeIn": args.milliseconds, "fadeOut": args.milliseconds}
        exchange("setUserConfig", {address: values for address in addresses})
    now = exchange("getUserConfig", {address: {} for address in addresses})
    refused = 0
    for address, mac in addresses.items():
        if address not in now:
            print("  %s  not answering" % mac)
            continue
        times = now[address].get("fadeIn"), now[address].get("fadeOut")
        wrong = args.milliseconds is not None and times != (args.milliseconds, args.milliseconds)
        refused += wrong
        print("  %s  brighter in %s ms, dimmer in %s ms%s" % (mac, times[0], times[1], "  (refused)" if wrong else ""))
    if refused:
        raise Failure("%d bulbs would not take it; on these bulbs the fade can only be set in the WiZ app" % refused)


def cmd_sweep(fixture, args):
    """Moves the brightness evenly from one value to another, for judging by eye."""
    state, _ = fixture.reconcile()
    base = dict(state["setting"], on=True)
    if args.kelvin:
        base.update(mode="white", kelvin=fixture.kelvin(args.kelvin))
    started, last = time.monotonic(), None
    while True:
        progress = min(1.0, (time.monotonic() - started) / args.seconds) if args.seconds > 0 else 1.0
        setting = dict(base, brightness=tidy(args.start + (args.end - args.start) * progress))
        bulbs = fixture.plan(setting)
        if bulbs != last:
            # Only when a bulb changes: most moments ask for nothing new.
            missed = fixture.apply(setting, "cli")
            print("%5.1fs  %s: %s%s" % (time.monotonic() - started, fixture.describe(setting),
                                        fixture.describe_bulbs(setting),
                                        "; not answering: " + ", ".join(missed) if missed else ""), flush=True)
            last = bulbs
        if progress >= 1.0:
            return
        time.sleep(0.2)


def named_bulb(fixture, name):
    """A bulb by its place: centre, a ring name from ring_names, "ring 3" or "3", or a MAC address."""
    centre, ring = fixture.layout()
    name = name.strip().lower()
    names = [str(label).lower() for label in settings()["ring_names"]]
    if name in ("centre", "center"):
        return centre
    if name in names and names.index(name) < len(ring):
        return ring[names.index(name)]
    place = name[4:].strip() if name.startswith("ring") else name
    if place.isdigit() and int(place) < len(ring):
        return ring[int(place)]
    try:
        if clean_mac(name) in fixture.macs:
            return clean_mac(name)
    except Failure:
        pass
    raise Failure("no bulb is called '%s'; try centre, %s, or ring 0-%d" % (
        name, ", ".join(names) or "a MAC address", len(ring) - 1))


def cmd_compare(fixture, args):
    """Sets one bulb by hand, leaving the rest, to match raw levels against white by eye.

    The fixture as it was is kept in compare.json. `--restore` puts every
    bulb back to it, with whoever had set it, so no hold is left behind.
    """
    saved = read_json(path("compare.json"), {})
    if args.restore:
        if not saved:
            raise Failure("nothing to restore")
        with fixture.locked():
            missed = fixture.apply(saved["setting"], saved["by"])
            state = fixture.state()
            state["by"], state["set_at"] = saved["by"], saved["set_at"]
            write_json(path("state.json"), state)
        os.remove(path("compare.json"))
        print("restored: %s" % fixture.describe(saved["setting"]))
        if missed:
            print("fixture: not answering: %s" % ", ".join(missed), file=sys.stderr)
        return
    if not args.bulb:
        raise Failure("say which bulb: fixture compare --bulb centre --raw-w 42")
    mac = named_bulb(fixture, args.bulb)
    if args.raw_c + args.raw_w == 0:
        raise Failure("--raw-c and --raw-w cannot both be 0")
    with fixture.locked():
        state, _ = fixture.reconcile()
        if not saved:
            write_json(path("compare.json"), {key: state[key] for key in ("setting", "by", "set_at")})
        look = pilot_look({"c": args.raw_c, "w": args.raw_w, "dimming": args.raw_dimming})
        if not fixture.send({mac: {"on": True, "look": look}}):
            raise Failure("%s is not answering" % mac)
    print("%s (%s): cold %d, warm %d at dimming %d; the others are untouched" % (
        args.bulb, mac, args.raw_c, args.raw_w, args.raw_dimming))
    print("put it back with: fixture compare --restore")


def cmd_status(fixture, args):
    state, pilots = fixture.reconcile()
    setting = state["setting"]
    print("Fixture: %s" % fixture.describe(setting))
    if setting["on"]:
        print("Bulbs:   %s" % fixture.describe_bulbs(setting))
    print("Set by:  %s, %s" % (state["by"], time.strftime("%F %T", time.localtime(state["set_at"]))))
    raw = fixture.raw(setting)
    if raw is not None and not raw["covered"]:
        print("Note:    this white is outside the measured points in raw_calibration; its brightness and colour are a guess")
    if os.path.exists(path("compare.json")):
        print("Note:    a bulb is set by hand for comparing; put it back with: fixture compare --restore")
    centre, ring = fixture.layout()
    names = settings()["ring_names"]
    if len(fixture.macs) == 7 and not settings()["layout_mapped"]:
        print("Layout:  not mapped yet; the list order stands in (set centre, ring and layout_mapped in fixture.json)")
    for mac in fixture.macs:
        pilot = pilots[mac]
        if pilot is None:
            print("  %s  not answering" % mac)
            continue
        look = " ".join("%s %s" % item for item in sorted(pilot_look(pilot).items()))
        place = "centre" if mac == centre else "ring %d" % ring.index(mac) if mac in ring else ""
        if mac in ring and ring.index(mac) < len(names):
            place += " " + str(names[ring.index(mac)])
        print("  %s  %-16s  %-15s %-3s  %s%s" % (mac, place, fixture.addresses.get(mac, "?"), "on" if pilot.get("state") else "off",
                                          look, "  (waiting for the last setting)" if mac in state["pending"] else ""))
    if args.json:
        print(json.dumps({"state": state, "bulbs": pilots}, indent=2, sort_keys=True))


def cmd_discover(fixture, args):
    """Lists the WiZ bulbs on the network, with the limits each one reports."""
    found = search()
    if not found:
        raise Failure("no WiZ bulb answered")
    addresses = {address: mac for mac, (address, _) in found.items()}
    wanted = {address: {} for address in addresses}
    system = exchange("getSystemConfig", wanted)
    model = exchange("getModelConfig", wanted)
    user = exchange("getUserConfig", wanted)
    kelvins, floors = [], []
    for address in sorted(addresses, key=lambda a: tuple(int(part) for part in a.split("."))):
        cct = model.get(address, {}).get("cctRange") or []
        floor = max(1, model.get(address, {}).get("minDimLevel") or 0, user.get(address, {}).get("minDimming") or 0)
        if len(cct) >= 2:
            kelvins.append((cct[0], cct[-1]))
        if address in model:
            floors.append(floor)
        print("%s  %-15s %s fw %s  %s  lowest dimming %s" % (
            addresses[address], address, system.get(address, {}).get("moduleName", "?"),
            system.get(address, {}).get("fwVersion", "?"),
            "%d-%dK" % (cct[0], cct[-1]) if len(cct) >= 2 else "white range unknown",
            floor if address in model else "unknown"))
    if not args.save:
        return
    saved = read_json(path("fixture.json"), {})
    known = [clean_mac(mac) for mac in saved.get("bulbs", [])]
    ordered = sorted(found, key=lambda mac: tuple(int(part) for part in found[mac][0].split(".")))
    saved["bulbs"] = known + [mac for mac in ordered if mac not in known]
    if kelvins:
        saved["kelvin_min"] = max(low for low, _ in kelvins)
        saved["kelvin_max"] = min(high for _, high in kelvins)
    if floors:
        saved["min_dimming"] = max(floors)
    for key in ("name", "port", "min_colour_dimming", "white_mode", "raw_calibration", "stream_rate"):
        saved.setdefault(key, SETTINGS_DEFAULTS[key])
    if len(saved["bulbs"]) == 7 and not saved.get("layout_mapped"):
        # A stand-in until someone looks at the fixture: the list order.
        saved.update(centre=saved["bulbs"][0], ring=saved["bulbs"][1:], layout_mapped=False)
    write_json(path("fixture.json"), saved)
    write_json(path("addresses.json"), {mac: address for mac, (address, _) in found.items()})
    print("saved %d bulbs to %s" % (len(saved["bulbs"]), path("fixture.json")))


def cmd_follow(fixture, args):
    if args.action == "apply":
        # The minute timer runs this, so it must never fail loudly.
        try:
            line = follow_apply(fixture)
        except Exception as error:  # noqa: BLE001
            line = "unexpected error: %r" % (error,)
        if line:
            print("%s  %s" % (time.strftime("%F %T"), line), flush=True)
        return
    if args.action in ("on", "off"):
        saved = dict(FOLLOW_DEFAULTS)
        saved.update(read_json(path("follow.json"), {}))
        saved["enabled"] = args.action == "on"
        write_json(path("follow.json"), saved)
        if args.action == "off":
            print("following is off; the fixture stays as it is")
            return
        # Switching on also ends any hold: take the fixture over now.
        fixture.claim("follow")
        line = follow_apply(fixture)
        print("following is on" + (": " + line if line else ""))
        return
    follow = follow_settings()
    print("Following: %s (day %s, night %s at %dK, hold %g min)" % (
        "on" if follow["enabled"] else "off", percent(follow["day_brightness"]),
        percent(follow["night_brightness"]), fixture.kelvin(follow["night_kelvin"]), follow["hold_minutes"]))
    now = time.time()
    try:
        sun = sundial_target(now)
        print("Sun:       %+.1f degrees, daylight %d%%" % (
            float(sun["sun_elevation"]), round(float(sun["daylight"]) * 100)))
        kelvin, brightness = follow_target(sun, follow, fixture)
        print("Target:    white %dK at %s" % (kelvin, percent(brightness)))
    except Failure as failure:
        print("Sun:       unknown (%s)" % failure)
    memory = read_json(path("follow-state.json"), {})
    try:
        setting = fixture.reconcile(dry=True)[0]["setting"]
        print("Fixture:   %s" % fixture.describe(setting))
        print("Bedtime:   %s" % bedtime_outlook(fixture, follow, memory, setting["on"], now))
        sentence = follow_step(fixture, now, send=False, memory=dict(memory))[1]
    except Failure as failure:
        sentence = "cannot follow the sun: %s" % failure
    print("Now:       %s" % sentence)


def build_parser():
    parser = argparse.ArgumentParser(prog="fixture", description="Drive several WiZ bulbs as one light.")
    commands = parser.add_subparsers(dest="command", required=True)

    def add(name, handler, text):
        command = commands.add_parser(name, help=text)
        command.set_defaults(handler=handler)
        return command

    def level(text):
        try:
            value = float(text)
        except ValueError:
            raise argparse.ArgumentTypeError("brightness must be a number")
        if not 0 < value <= 100:
            raise argparse.ArgumentTypeError("brightness must be above 0 and at most 100")
        return value

    add("on", cmd_on, "switch the fixture on as it was")
    add("off", cmd_off, "switch every bulb off")
    white = add("white", cmd_white, "white light: fixture white 2700 40")
    white.add_argument("kelvin", type=whole(1000, 10000, "kelvin"))
    white.add_argument("brightness", type=level)
    for name in ("colour", "color"):
        colour = add(name, cmd_colour, "a colour: fixture colour 240 100 40")
        colour.add_argument("hue", type=whole(0, 360, "hue"))
        colour.add_argument("saturation", type=whole(0, 100, "saturation"))
        colour.add_argument("brightness", type=level)
    brightness = add("brightness", cmd_brightness, "change the brightness, keep the colour")
    brightness.add_argument("brightness", type=level)
    fade = add("fade", cmd_fade, "show the bulbs' own fade time, or try to set it: fixture fade 100")
    fade.add_argument("milliseconds", nargs="?", type=whole(0, 10000, "milliseconds"))
    sweep = add("sweep", cmd_sweep, "move slowly between two brightnesses: fixture sweep 1.2 0.8 --seconds 60")
    sweep.add_argument("start", type=level)
    sweep.add_argument("end", type=level)
    sweep.add_argument("--seconds", type=float, default=30.0, help="how long to take (default 30)")
    sweep.add_argument("--kelvin", type=whole(1000, 10000, "kelvin"), help="white at this colour temperature")
    compare = add("compare", cmd_compare, "set one bulb by hand: fixture compare --bulb centre --raw-w 42")
    compare.add_argument("--bulb", help="centre, a ring name such as north, ring 0-5, or a MAC address")
    compare.add_argument("--raw-w", type=whole(0, 255, "warm level"), default=1, help="warm white LED, 0-255 (default 1)")
    compare.add_argument("--raw-c", type=whole(0, 255, "cold level"), default=0, help="cold white LED, 0-255 (default 0)")
    compare.add_argument("--raw-dimming", type=whole(RAW_DIMMING, 100, "dimming"), default=RAW_DIMMING,
                         help="dimming, 10-100 (default 10)")
    compare.add_argument("--restore", action="store_true", help="put the fixture back as it was")
    status = add("status", cmd_status, "ask every bulb what it is doing")
    status.add_argument("--json", action="store_true", help="also print everything as JSON")
    discover = add("discover", cmd_discover, "list the WiZ bulbs on the network")
    discover.add_argument("--save", action="store_true", help="make the bulbs found the fixture")
    follow = add("follow", cmd_follow, "follow the sun through the day: fixture follow on")
    follow.add_argument("action", nargs="?", choices=["on", "off", "status", "apply"], default="status")
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        fixture = None if args.handler is cmd_discover else Fixture()
        args.handler(fixture, args)
    except Failure as failure:
        if getattr(args, "action", None) == "apply":
            # The minute timer: say it once, in the log's form.
            print("%s  %s" % (time.strftime("%F %T"), failure), flush=True)
            return 0
        print("fixture: %s" % failure, file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
